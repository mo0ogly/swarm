# Keep published documents and archives byte-for-byte intact.
*.pdf binary
*.pptx binary
*.zip binary
# Preserve exact stdout bytes of hash-bound qualification logs.
docs/plans/version-history/**/*.log whitespace=-blank-at-eol,-blank-at-eof
# Preserve verbatim source excerpts in hash-bound review evidence.
docs/plans/clear-launch-recovery/T1-handoff.md whitespace=-blank-at-eol
docs/plans/clear-launch-recovery/T1-handoff-before-guidance-revalidation.md whitespace=-blank-at-eol
# Patch context prefixes are data; preserve the hash-bound recovery artifact.
docs/plans/engine-cursor-contract/recovery/*.patch whitespace=-blank-at-eol,-space-before-tab

# Preserve raw evidence byte-for-byte, including terminal spaces and patch
# context lines. Editorial documents and application sources keep Git checks.
docs/**/evidence/**/*.out whitespace=-blank-at-eol,-blank-at-eof
docs/**/evidence/**/*.stdout whitespace=-blank-at-eol,-blank-at-eof
docs/**/evidence/**/*.txt whitespace=-blank-at-eol,-blank-at-eof
docs/**/evidence/**/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

# Qualification archives also retain exact source preimages, command output
# and diff context as data. Keep those historical bytes; application sources
# and editorial documents outside these evidence roots retain normal checks.
docs/plans/actions-confiance/verification-*/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
docs/plans/deepagents-integration/evidence/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

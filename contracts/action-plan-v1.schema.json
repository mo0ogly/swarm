{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Swarm planner response version 1",
  "description": "Provider response before operator review. Engine additionally checks UTF-8 byte limit, whitespace, references, uniqueness and acyclic dependencies. Operator answers are required at commit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "objective",
    "assumptions",
    "questions",
    "tasks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "const": ""
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "role",
          "scope",
          "deliverable",
          "depends",
          "criteria",
          "proof",
          "entry",
          "validation",
          "delivery",
          "stop",
          "max_attempts",
          "max_tool_calls"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "worker",
              "planner",
              "subplanner"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "deliverable": {
            "type": "string",
            "minLength": 1
          },
          "depends": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "proof": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "type": "string",
            "minLength": 1
          },
          "validation": {
            "type": "string",
            "minLength": 1
          },
          "delivery": {
            "type": "string",
            "minLength": 1
          },
          "stop": {
            "type": "string",
            "minLength": 1
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "max_tool_calls": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    }
  }
}

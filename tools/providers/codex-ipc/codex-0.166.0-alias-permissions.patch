+        use std::os::unix::fs::{DirBuilderExt, PermissionsExt};
+
+        // Establish the required mode at creation, including new ancestors.
+        // This needs no chmod capability when the new directory is already safe.
+        std::fs::DirBuilder::new().recursive(true).mode(0o700).create(&temp_root)?;
+
+        // Keep the existing exact private-directory mode. A correctly created
+        // 0700 directory needs no metadata mutation; confinement can deny chmod
+        // without weakening its mode. An unsafe mode still requires the same
+        // successful correction as upstream, otherwise setup refuses.
+        let current_mode = std::fs::metadata(&temp_root)?.permissions().mode() & 0o7777;
+        if current_mode != 0o700 {
+            std::fs::set_permissions(&temp_root, std::fs::Permissions::from_mode(0o700))?;
+        }

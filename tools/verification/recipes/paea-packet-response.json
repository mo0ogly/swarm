{
  "schema_version": 1,
  "id": "paea-packet-response",
  "inputs": [
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    ".cargo/config.toml",
    "rust/crates/swarm-enrollment-authority/**/*",
    "rust/crates/swarm-enrollment-bootstrap/**/*",
    "rust/crates/swarm-enrollment-config/**/*",
    "rust/crates/swarm-enrollment-proof/**/*",
    "rust/crates/swarm-enrollment-state/**/*",
    "rust/crates/swarm-identity-contract/**/*",
    "rust/crates/swarm-wire-json/**/*",
    "tests/fixtures/paea_provisioning_request.json",
    "tools/verification/recipe.py",
    "tools/verification/recipes/paea-personal-service-core.json",
    "schemas/paea/personal-service-response-v1.schema.json",
    "tests/paea_service_response_schema_test.py",
    "rust/crates/swarm-linux-identity-channel/**/*",
    "tools/verification/recipes/paea-controller-packet.json",
    "tests/paea_controller_rustdoc_test.py",
    "tests/paea_initial_rustdoc_test.py",
    "tests/paea_spawned_rustdoc_test.py",
    "tools/verification/recipes/paea-spawned-controller.json",
    "tools/verification/recipes/paea-atomic-controller.json",
    "tests/paea_atomic_rustdoc_test.py",
    "tests/paea_packet_response_rustdoc_test.py",
    "tools/verification/recipes/paea-packet-response.json"
  ],
  "environment": {
    "CARGO_TARGET_DIR": "{root}/.cache/paea-verification-target",
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_INCREMENTAL": "0",
    "RUSTDOCFLAGS": "-D warnings"
  },
  "steps": [
    {
      "id": "actual-kernel-send-records-refusals-and-recovery",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-linux-identity-channel",
        "--test",
        "send_packet",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "packet_send_exact_records_and_guarded_input ... ok",
        "packet_send_empty_or_alias_options_refuses_before_native_then_recovers ... ok",
        "packet_send_closed_peer_keeps_original_cause_and_fresh_recovery ... ok",
        "5 passed; 0 failed",
        "packet_send_actual_kernel_size_refusal_and_recovery ... ok",
        "packet_send_nonblocking_full_queue_refuses_then_drain_recovers ... ok",
        "SEND_KERNEL_CAPACITY bytes=",
        "SEND_QUEUE_RECOVERY records="
      ],
      "required_stderr": []
    },
    {
      "id": "isolated-default-unblocked-sigpipe",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-linux-identity-channel",
        "--lib",
        "kernel::send::tests::closed_peer_send_with_default_unblocked_sigpipe_survives",
        "--",
        "--exact",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "closed_peer_send_with_default_unblocked_sigpipe_survives ... ok",
        "1 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "actual-response-packet-and-known-state-after-refusal",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-enrollment-authority",
        "--test",
        "personal_service",
        "personal_service_packet_response_",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "personal_service_packet_response_exact_bound_result_and_recovery ... ok",
        "personal_service_packet_response_closed_peer_retains_known_view_and_reopen ... ok",
        "personal_service_packet_response_encode_refusal_before_queue ... ok",
        "3 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "strict-packet-response-rustdoc",
      "command": [
        "cargo",
        "doc",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-linux-identity-channel",
        "-p",
        "swarm-enrollment-authority",
        "--no-deps",
        "--document-private-items"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "Generated"
      ]
    },
    {
      "id": "exact-packet-response-sources-and-prose",
      "command": [
        "python3",
        "tests/paea_packet_response_rustdoc_test.py"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "SOURCE_BOUND_RUSTDOC_PASS sources=4 pages=4"
      ],
      "required_stderr": []
    }
  ]
}

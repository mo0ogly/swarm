{
  "schema_version": 1,
  "id": "web-mission-discovery-rust",
  "inputs": [
    "rust/crates/swarm-engine/src/root_store/mission_discovery.rs",
    "rust/crates/swarm-engine/src/root_store.rs",
    "rust/crates/swarm-engine/src/lib.rs",
    "rust/crates/swarm-engine/src/mission_controls.rs",
    "rust/crates/swarm-engine/src/mission_control_write.rs",
    "rust/crates/swarm-engine/src/mission_supervision_store.rs",
    "rust/crates/swarm-engine/src/root_store/material_path.rs",
    "rust/crates/swarm-engine/src/engine_settings.rs",
    "rust/crates/swarm-engine/tests/mission_discovery_observation.rs",
    "rust/crates/swarm-cli/src/native_web/conductor.rs",
    "tests/rust_web_discovery_lock.py",
    "tests/rust_agent_model_route.py",
    "tests/rust_native_http_cli.py"
  ],
  "environment": {},
  "steps": [
    {
      "id": "owned-integration",
      "command": [
        "python3",
        "-c",
        "import os,subprocess,hashlib\nfrom pathlib import Path\np=Path(os.environ['SWARM_DISCOVERY_TEST_ELF']);assert hashlib.sha256(p.read_bytes()).hexdigest()==os.environ['SWARM_DISCOVERY_TEST_SHA']\nsubprocess.run([str(p),'--nocapture'],check=True)"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "test result: ok. 3 passed",
        "discovery_observes_saved_data_while_admin_reservation_is_exclusive ... ok",
        "discovery_refuses_a_replaced_physical_project ... ok"
      ],
      "required_stderr": []
    },
    {
      "id": "public-lock",
      "command": [
        "python3",
        "-c",
        "import os,subprocess,tempfile\nfrom pathlib import Path\np=Path(tempfile.mkdtemp(prefix='web-discovery-lock-',dir='.cache')).resolve()/'journey'\nsubprocess.run(['python3','tests/rust_web_discovery_lock.py','--binary',os.environ['SWARM_WEB_DISCOVERY_BINARY'],'--output',str(p)],check=True)\nprint('WEB_DISCOVERY_EVIDENCE '+str(p))"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "WEB_DISCOVERY_LOCK_PASS 5",
        "PASS discovery-thread-progresses-under-exclusive-lock",
        "PASS discovery-http-after-contention"
      ],
      "required_stderr": []
    }
  ]
}

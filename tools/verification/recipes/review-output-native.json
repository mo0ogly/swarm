    "web/wattson_themes.css",
    "web/swarm-design.css",
    "web/swarm-logo.png",
    "tests/rust_native_login_browser.py",
    "tests/rust_native_login_ui.cjs",
    "web/native-runtime.html",
    "web/native-runtime.css",
    "web/native-runtime.js",
    "web/i18n.js",
    "web/processes.css",
    "frontend/engine-settings/admin.css",
    "scripts/i18n/build.cjs",
    "package.json",
    "package-lock.json",
    "tests/i18n_test.cjs",
    "web/pilot-graph.js",
    "tests/engine_settings_apply_ack_test.cjs",
    "tests/native_settings_http_adapter_test.cjs",
    "tests/rust_native_admin_ui.cjs",
    "tests/rust_native_fixture_failures.py",
    "tools/agent-workflows/check.py",
    "tests/rust_native_completion_recovery.py",
    "tests/rust_scoped_worker.py",
    ".gitignore",
    "tools/verification/verify_npm_archive.py",
    "tests/browser_verification_runtime_test.cjs",
    "tests/browser_npm_baseline_test.cjs",
    "tests/rust_planning_bootstrap.py",
    "tests/rust_planning_activation.py",
    "tests/rust_planning_lease.py",
    "tests/rust_planning_budget.py",
    "tests/rust_planning_provider_guard.py",
    "tests/rust_planning_call_inputs.py",
    "tests/rust_planning_call_preview.py",
    "tests/rust_planning_call_contract.py",
    "tests/rust_planning_output.py",
    "tests/rust_native_parent_death.py",
    "tests/rust_planning_context_evolution.py",
    "tests/rust_planning_wait.py",
    "tests/rust_planning_native_run.py",
    "tests/rust_planning_step.py",
    "tests/rust_planning_rejection_recovery.py",
    "tests/rust_planning_decision.py",
    "tools/verification/recipes/agent-native-runtime.json",
    "tests/rust_planning_failure_recovery.py",
    "tests/rust_planning_unadmitted_recovery.py",
    "tests/rust_planning_worker_public_flow.py",
    "tools/verification/test_recipe.py",
    "tests/rust_native_task_validation.py",
    "tests/rust_native_task_validation_preview.py",
    "tests/admin_settings_groups_ui.cjs",
    "tests/rust_native_admin_ui.cjs",
    "web/native-runtime.js",
    "frontend/engine-settings/admin.css",
    "version_history.json",
    "tests/admin_budget_ui_test.cjs",
    "tests/admin_budget_http_ui.cjs",
    "docs/architecture/ADMIN-AI-ADVICE.md",
    "docs/en/ADMIN-AI-ADVICE.md",
    "docs/architecture/RUST-MIGRATION.md",
    "docs/en/RUST-MIGRATION.md",
    "tests/rust_native_task_validation_failures.py",
    "tests/rust_native_task_validation_output.py",
    "tools/verification/recipes/native-task-validation.json",
    "tests/rust_native_task_validation_ordinary.py",
    "tests/rust_native_task_validation_source_compat.py",
    "tests/rust_native_task_validation_batch.py",
    "contracts/agent-wire-layout.v1.json"

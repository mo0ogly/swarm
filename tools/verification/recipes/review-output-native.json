  "environment": {
    "CARGO_TARGET_DIR": "{root}/rust/target/r97",
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_INCREMENTAL": "0",
    "RUSTDOCFLAGS": "-D warnings"
  },
  "steps": [
    {
      "id": "review-response-stream",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--test",
        "review_output",
        "--test",
        "review_reply",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "review_stream_claude_codex_chunks_preserve_reply_and_unverified_facts ... ok",
        "review_stream_domain_refusal_retains_safe_cause_and_prevents_reuse ... ok",
        "review_stream_explicit_response_cap_and_saved_text_policy_have_no_fallback ... ok",
        "review_stream_unknown_criterion_is_changes_requested_and_missing_reply_refuses ... ok",
        "review_stream_tool_and_incomplete_transport_refuse_before_domain_success ... ok",
        "5 passed; 0 failed",
        "4 passed; 0 failed",
        "reply_parsing_preserves_verdicts_order_and_literal_or_markdown_evidence ... ok",
        "invalid_replies_refuse_and_recover_without_private_diagnostics ... ok",
        "reply_byte_limits_and_explicit_normalized_minimum_have_observable_effects ... ok",
        "v6_journal_replays_and_v7_adoption_preserves_history_and_refuses_partial_groups ... ok"
      ],
      "required_stderr": []
    },
    {
      "id": "clippy-native-cli",
      "command": [
        "cargo",
        "clippy",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-cli",
        "--bin",
        "swarm-rust",
        "--",
        "-D",
        "warnings"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "Finished"
      ]
    },
    {
      "id": "native-rustdoc",
      "command": [
        "cargo",
        "doc",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "-p",
        "swarm-cli",
        "--no-deps"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "Finished"
      ]
    }
  ]
}

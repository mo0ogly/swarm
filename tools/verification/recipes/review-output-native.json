    "tools/rust-migration/generate_agent_models.py",
    "tools/rust-migration/test_generate_agent_models.py",
    "frontend/engine-settings/admin.js",
    "web/i18n-en.js",
    "tests/rust_agent_model_route.py",
    "tests/rust_manual_mission.py",
    "AGENTS.md",
    "CLAUDE.md",
    "tests/rust_web_policy_admin_ui.cjs",
    "tests/helpers/browser_verification_runtime.cjs",
    "tests/helpers/engine_settings_admin_state.cjs",
    "tests/helpers/verification_cleanup.cjs",
    "tests/verification_cleanup_test.cjs",
    "tests/rust_native_http_cli.py",
    "web/access.html",
    "web/access.css",

    {
      "id": "public-cli",
      "command": [
        "python3",
        "-c",
        "import os,tempfile,subprocess\nfrom pathlib import Path\np=Path(tempfile.mkdtemp(prefix='agent-history-',dir='.cache')).resolve()/'journey'\nsubprocess.run(['python3','tests/rust_agent_archive_history.py','--binary',os.environ['SWARM_AGENT_HISTORY_BINARY'],'--output',str(p)],check=True)\nprint('AGENT_HISTORY_EVIDENCE '+str(p))"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "AGENT_ARCHIVE_HISTORY_VERIFIED 102"
      ],
      "required_stderr": []
    }
  ]

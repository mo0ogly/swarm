{
  "schema_version": 1,
  "id": "blp-preparation-transport-public",
  "inputs": [
    "tests/blp_attribution_history_cli.py",
    "tests/fixture_area.py",
    "tests/rust_agent_model_route.py",
    "tools/verification/recipe.py",
    "tests/rust_native_http_cli.py",
    "tests/blp_transport_public.py",
    "rust/crates/swarm-engine/src/root_store/preparation_transport.rs",

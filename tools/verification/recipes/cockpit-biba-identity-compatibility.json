        "-c",
        "import os,subprocess,tempfile\nfrom pathlib import Path\np=Path(tempfile.mkdtemp(prefix='cockpit-biba-',dir='.cache')).resolve()/'journey'\nsubprocess.run(['python3','tests/rust_cockpit_biba_compatibility.py','--binary',os.environ['SWARM_COCKPIT_BIBA_BINARY'],'--output',str(p)],check=True)\nprint('COCKPIT_BIBA_IDENTITY_EVIDENCE '+str(p))"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "\"qualified\": true",
        "\"status\": \"passed\"",
        "\"status\": \"biba-guard-validated\"",
        "\"status\": \"workspace-identity-refused\"",
        "COCKPIT_BIBA_IDENTITY_EVIDENCE"

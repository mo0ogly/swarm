  "environment": {
    "CARGO_TARGET_DIR": "{root}/rust/target/r97",
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_INCREMENTAL": "0",
    "RUSTDOCFLAGS": "-D warnings"
  },
  "steps": [
    {
      "id": "planning-output",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--locked",
        "--offline",
        "-p",
        "swarm-engine",
        "--test",
        "planning_output",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "13 passed; 0 failed",
        "provider_response_nonplanning_domain_preserves_exact_terminal_bytes ... ok",
        "provider_response_explicit_cap_and_saved_event_policy_are_distinct ... ok",
        "provider_response_terminal_failures_and_nonjson_text_remain_explicit ... ok",
        "planning_output_tool_events_refuse_and_latch_without_restricting_generic_transport ... ok"
      ],
      "required_stderr": []
    },
    {
      "id": "normal-build",
      "command": [
        "cargo",
        "build",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-cli",
        "--message-format=json"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "compiler-artifact"
      ],
      "required_stderr": []
    },
    {
      "id": "public-tool-free-planning",
      "command": [
        "python3",
        "-c",
        "import json,subprocess,sys,tempfile; from pathlib import Path; base=Path(tempfile.mkdtemp(prefix='planning-tool-free-',dir='.cache')).resolve(); q=subprocess.run([sys.executable,'tests/rust_planning_tool_free.py','--binary',str(Path('rust/target/r97/debug/swarm-rust').resolve()),'--output',str(base/'public')],check=True); assert json.loads((base/'public/result.json').read_bytes())['status']=='PASS'; print('PLANNING_TOOL_FREE_RECIPE_PASS '+str(base))"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "PLANNING_TOOL_FREE_PUBLIC_PASS",
        "PLANNING_TOOL_FREE_RECIPE_PASS"
      ],
      "required_stderr": []
    },
    {
      "id": "clippy-native-cli",
      "command": [
        "cargo",
        "clippy",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-cli",
        "--bin",
        "swarm-rust",
        "--",
        "-D",
        "warnings"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "Finished"
      ]
    },
    {
      "id": "native-rustdoc",
      "command": [
        "cargo",
        "doc",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "-p",
        "swarm-cli",
        "--no-deps"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "Finished"
      ]
    }
  ]
}

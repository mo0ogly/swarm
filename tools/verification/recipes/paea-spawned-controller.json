{
  "schema_version": 1,
  "id": "paea-spawned-controller",
  "inputs": [
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    ".cargo/config.toml",
    "rust/crates/swarm-enrollment-authority/**/*",
    "rust/crates/swarm-enrollment-bootstrap/**/*",
    "rust/crates/swarm-enrollment-config/**/*",
    "rust/crates/swarm-enrollment-proof/**/*",
    "rust/crates/swarm-enrollment-state/**/*",
    "rust/crates/swarm-identity-contract/**/*",
    "rust/crates/swarm-wire-json/**/*",
    "tests/fixtures/paea_provisioning_request.json",
    "tools/verification/recipe.py",
    "tools/verification/recipes/paea-personal-service-core.json",
    "schemas/paea/personal-service-response-v1.schema.json",
    "tests/paea_service_response_schema_test.py",
    "rust/crates/swarm-linux-identity-channel/**/*",
    "tools/verification/recipes/paea-controller-packet.json",
    "tests/paea_controller_rustdoc_test.py",
    "tests/paea_initial_rustdoc_test.py",
    "tests/paea_spawned_rustdoc_test.py",
    "tools/verification/recipes/paea-spawned-controller.json"
  ],
  "environment": {
    "CARGO_TARGET_DIR": "{root}/.cache/paea-verification-target",
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_INCREMENTAL": "0",
    "RUSTDOCFLAGS": "-D warnings"
  },
  "steps": [
    {
      "id": "actual-child-subject-sender-switch-and-exit",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-linux-identity-channel",
        "--test",
        "spawn_binding",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "spawned_process_anchor_child_then_same_uid_parent_refusal_and_recovery ... ok",
        "spawned_process_anchor_reaped_child_refuses_then_fresh_control ... ok",
        "2 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "actual-non-pidfs-refusal-with-live-control",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-linux-identity-channel",
        "--lib",
        "process_anchor_tests::",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "process_anchor_non_pidfs_refuses_after_live_child_control ... ok",
        "1 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "composed-process-namespace-decode-and-retained-reply",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-enrollment-authority",
        "--lib",
        "personal_service::controller_packet::tests::",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "spawned_packet_subject_before_decode_and_known_reply_recovery ... ok",
        "spawned_packet_matching_process_keeps_namespace_gate ... ok",
        "controller_packet_after_use_and_custom_io_preserve_all_known_error_branches ... ok",
        "10 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "public-pinned-uid-before-expired-process-and-decode",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-enrollment-authority",
        "--test",
        "personal_service",
        "personal_service_spawned_dispatch_wrong_uid_before_expired_anchor",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "personal_service_spawned_dispatch_wrong_uid_before_expired_anchor ... ok",
        "1 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "strict-doc-swarm-linux-identity-channel",
      "command": [
        "cargo",
        "doc",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-linux-identity-channel",
        "--no-deps",
        "--document-private-items"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "Finished"
      ]
    },
    {
      "id": "strict-doc-swarm-enrollment-authority",
      "command": [
        "cargo",
        "doc",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-enrollment-authority",
        "--no-deps",
        "--document-private-items"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "Finished"
      ]
    },
    {
      "id": "exact-current-doc-source-contracts",
      "command": [
        "python3",
        "tests/paea_spawned_rustdoc_test.py"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "SPAWN_SOURCE_BOUND_RUSTDOC_PASS sources=4 pages=6"
      ],
      "required_stderr": []
    }
  ]
}

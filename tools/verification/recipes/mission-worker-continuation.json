    "rust/crates/swarm-engine/Cargo.toml",
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    "tests/rust_mission_worker_continuation.py",
    "tests/test_rust_mission_worker_continuation_guards.py",
    "tests/rust_*.py",
    "docs/architecture/NATIVE-MISSION-WORKER.md",
    "docs/en/NATIVE-MISSION-WORKER.md"
  ],
  "environment": {},
  "steps": [
    {
      "id": "continuation-ledger-wrapper-refusal-recovery-guards",
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_rust_mission_worker_continuation_guards.py",
        "-v"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "test_profile_hash_default_and_test_identity",
        "test_exact_ignored_listing_refuses_absent_extra_and_failed",
        "test_named_execution_refuses_zero_failed_ignored_or_wrong_name",
        "test_result_requires_exact_positive_typed_rows_twice_and_cleanup",
        "test_fresh_output_refuses_existing_and_dangling_symlink",
        "test_invoke_forwards_fixture_environment_without_recording_values",
        "test_failure_publication_preserves_primary_and_secondary_causes",
        "Ran 7 tests",
        "OK"
      ]
    },
    {
      "id": "actual-owned-queued-agent-exact-ledger-two-observations",
      "command": [
        "python3",
        "-c",
        "import os,subprocess,tempfile\nfrom pathlib import Path\nbase=Path(tempfile.mkdtemp(prefix='mission-worker-continuation-',dir='.cache')).resolve()\nsubprocess.run(['python3','tests/rust_mission_worker_continuation.py','--binary',os.environ['SWARM_CONTINUATION_BINARY'],'--profile',os.environ['SWARM_CONTINUATION_PROFILE'],'--test-binary',os.environ['SWARM_CONTINUATION_TEST_BINARY'],'--test-profile',os.environ['SWARM_CONTINUATION_TEST_PROFILE'],'--output',str(base/'run')],check=True)\nprint('REPLAY_EVIDENCE '+str(base))\n"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "PASS real nonempty reservation ledger preserved across two continuation observations",
        "REPLAY_EVIDENCE"
      ],
      "required_stderr": []
    }
  ]
}

{
  "schema_version": 1,
  "id": "native-managed-unstarted-policy",
  "inputs": [
    "tests/rust_agent_model_route.py",
    "tests/rust_managed_planning.py",
    "tests/rust_managed_unstarted_policy.py",
    "tests/rust_memory_files.py",
    "rust/crates/swarm-engine/src/mutation_guard.rs",
    "rust/crates/swarm-engine/src/work_engine.rs",
    "rust/crates/swarm-engine/src/root_store.rs",
    "rust/crates/swarm-engine/src/root_store/task_validation.rs",
    "rust/crates/swarm-engine/src/validation_policy.rs",
    "rust/crates/swarm-engine/examples/identity_plan_probe.rs",
    "docs/architecture/NATIVE-WORKER-RECOVERY.md",
    "docs/en/NATIVE-WORKER-RECOVERY.md",
    "version_history.json"
  ],
  "environment": {},
  "steps": [
    {
      "id": "managed-unstarted-task-first-policy",
      "command": [
        "python3",
        "-c",
        "import os,subprocess; names=['binary','previous','profile','projection-probe','output']; subprocess.run(['python3','tests/rust_managed_unstarted_policy.py',*[part for name in names for part in ('--'+name,os.environ['SWARM_UNSTARTED_POLICY_'+name.upper().replace('-','_')])]],check=True)"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "PASS unstarted-policy-previous-binary-refuses",
        "PASS unstarted-policy-refusals-leave-work-unchanged",
        "PASS unstarted-policy-first-automatic-policy-recorded",
        "PASS unstarted-policy-replacement-refused",
        "MANAGED_UNSTARTED_POLICY_PASS"
      ],
      "required_stderr": []
    }
  ]
}

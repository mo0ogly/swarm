      "expected_exit": 0,
      "required_stdout": [
        "withdrawn_preview_stops_session_without_hiding_effects_or_cleanup ... ok",
        "report_read_withdrawal_preserves_prior_work_and_output_causes ... ok",
        "synchronized_withdrawal_stops_only_its_work_and_keeps_commit ... ok",
        "planner_finish_distinguishes_main_shutdown_and_actual_stop_metadata ... ok"
      ],
      "required_stderr": []
    },
    {
      "id": "two-managed-workers-under-real-http-conductor",
      "command": [
        "python3",
        "-c",
        "import os,subprocess,tempfile\nfrom pathlib import Path\nb=Path(tempfile.mkdtemp(prefix='managed-auto-worker-',dir='.cache')).resolve()\nfor label,extra in [('root',[]),('subproject',['--subproject'])]:\n p=b/label\n subprocess.run(['python3','tests/rust_managed_auto_worker.py','--binary',os.environ['SWARM_STATUS_CONTRACT_BINARY'],'--profile',os.environ['SWARM_STATUS_CONTRACT_PROFILE'],'--output',str(p),*extra],check=True)\nprint('REPLAY_EVIDENCE '+str(b))\n"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "PASS managed-auto-cycle-1-settles-once-with-durable-original",
        "PASS managed-auto-cycle-2-settles-once-with-durable-original",
        "PASS managed-auto-paused-reopen-retains-first-completion",
        "PASS managed-auto-final-reopen-has-no-third-agent-or-fake-acceptance",

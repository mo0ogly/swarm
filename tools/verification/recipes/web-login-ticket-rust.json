        "rust/Cargo.toml",
        "--locked",
        "--offline",
        "-p",
        "swarm-engine",
        "--lib",
        "web_login_ticket"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "web_login_ticket::tests::ticket_is_single_use_address_bound_and_expires ... ok",
        "web_login_ticket::tests::invalid_lifetime_refuses_without_file ... ok",
        "web_login_ticket::tests::installation_default_is_current_schema ... ok",
        "web_login_ticket::tests::historical_absence_and_zero_refuse_without_fallback ... ok",
        "web_login_ticket::tests::rotated_owner_key_orphans_unconsumed_ticket ... ok",
        "5 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "engine-owner-key-rotation",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--locked",
        "--offline",
        "-p",
        "swarm-engine",
        "--lib",

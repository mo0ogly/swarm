        "-c",
        "import subprocess,time\nfrom pathlib import Path\nout=Path('.swarm-fixtures')/('field-ui-recipe-%d'%time.time_ns())\nprint('RETAINED_FLOW',out,flush=True)\nsubprocess.run(['node','tests/rust_settings_field_ui.cjs','bin/swarm','runtime_temporary_directory',str(out)],check=True)"
      ],

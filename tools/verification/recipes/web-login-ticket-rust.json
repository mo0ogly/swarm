      "required_stderr": []
    },
    {
      "id": "fixture-area-follows-setting",
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-v",
        "-s",
        "tests",
        "-p",
        "test_fixture_area.py"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "test_saved_value_then_default_then_refusals",
        "OK"
      ]
    },
    {
      "id": "web-ticket-login-and-principal",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--locked",
        "--offline",
        "-p",
        "swarm-web",
        "--test",
        "login",
        "--test",
        "access"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "native_login_single_use_ticket_signs_in_once_without_key_copy ... ok",

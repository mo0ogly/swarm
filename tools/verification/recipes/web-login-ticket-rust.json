      "expected_exit": 0,
      "required_stdout": [
        "catalog_covers_all_actual_values_and_nullable_fields_match_authoritative_validation ... ok",
        "2 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "runtime-temporary-directory",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--locked",
        "--offline",
        "-p",
        "swarm-engine",
        "--test",
        "runtime_temporary"

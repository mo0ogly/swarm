        "Ran 12 tests",
        "OK"
      ]
    },
    {
      "id": "installed-browser-signin-signout",
      "command": [
        "python3",
        "-c",
        "import subprocess,time\nfrom pathlib import Path\nout=Path('.swarm-fixtures')/('signin-ui-recipe-%d'%time.time_ns())\nprint('RETAINED_FLOW',out,flush=True)\nsubprocess.run(['node','tests/rust_web_signin_ui.cjs','bin/swarm',str(out)],check=True)"
      ],

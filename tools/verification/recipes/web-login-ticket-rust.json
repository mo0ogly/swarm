      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-v",
        "-s",
        "tests",
        "-p",
        "test_swarm_local.py"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "test_local_opener_gets_native_login_without_terminal_disclosure",

{
  "schema_version": 1,
  "id": "paea-local-delivery",
  "inputs": [
    "tests/paea_local_delivery_test.cjs",
    "version_history.json",
    "web/paea.*",
    "web/i18n*.js",
    "web/swarm-design.css",
    "web/wattson_themes.css",
    "web/swarm-logo.png",
    "web/trust-native.css",
    "web/paea-payment.html",
    "web/paea-compare.html",
    "web/paea-examples/v1/*.json",
    "web/paea-inspect.html",
    "schemas/paea/inspection-v1.schema.json",
    "web/paea-approval.html",
    "schemas/paea/approval-report-v1.schema.json",
    "web/paea-lab.html",
    "web/paea-lab.js"
  ],
  "environment": {},
  "steps": [
    {
      "id": "read-only-local-browser",
      "command": [
        "node",
        "tests/paea_local_delivery_test.cjs"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "LIVE_PAEA_DELIVERY_VERIFIED 56",
        "fr-dialog-current-PAEA-evolutions",
        "en-dialog-current-PAEA-evolutions",
        "no-browser-errors-or-writes",
        "fr-live-payment-menu-and-fields",
        "en-live-payment-limits-no-submission",
        "fr-live-comparison-menu-and-fields",
        "en-live-comparison-limits-no-submission",
        "fr-live-receipt-example-links",
        "en-live-comparison-example-links",
        "en-live-payment-example-links",
        "en-live-inspection-menu-fields",
        "fr-live-inspection-limits-no-submission",
        "en-live-inspection-example-links",
        "fr-live-approval-menu-fields",
        "en-live-approval-limits-no-submission",
        "en-live-approval-example-links",
        "fr-live-laboratory-menu-and-command",
        "en-live-laboratory-limits-no-execution"
      ],
      "required_stderr": []
    },
    {
      "id": "failed-script-aborts-wait",
      "command": [
        "node",
        "tests/paea_local_delivery_test.cjs",
        "--fault-version-script"
      ],
      "expected_exit": 1,
      "required_stdout": [
        "INJECTED_VERSION_SCRIPT_FAILURE"
      ],
      "required_stderr": [
        "unexpected-browser-diagnostic"
      ]
    }
  ]
}

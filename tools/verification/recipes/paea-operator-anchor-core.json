      "required_stderr": []
    },
    {
      "id": "closed-exact-anchor-digest-schema",
      "command": [
        "python3",
        "tests/paea_operator_anchor_schema_test.py"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "Ran 3 tests",
        "OK"
      ]
    },
    {
      "id": "private-anchor-and-read-rustdoc",
      "command": [
        "cargo",
        "doc",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-enrollment-authority",
        "-p",
        "swarm-enrollment-config",
        "--no-deps",
        "--document-private-items"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "Documenting swarm-enrollment-authority",
        "Documenting swarm-enrollment-config",
        "Finished"
      ]

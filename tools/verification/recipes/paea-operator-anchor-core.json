        "checkpoint_private_create_reopen_binding_refusal_then_recovery",
        "checkpoint_visible_and_cleanup_failure_retains_effect_then_reopens",
        "checkpoint_read_ack_failures_withhold_record_then_recover",
        "checkpoint_late_close_retains_decode_and_independent_causes",
        "checkpoint_custom_io_and_cleanup_matrix_keeps_typed_causes",
        "checkpoint_invalid_binding_and_record_keep_independent_close"

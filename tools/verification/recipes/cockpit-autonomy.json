    {
      "id": "historical-public-http-and-embedded-browser",
      "command": [
        "python3",
        "-c",
        "import os,tempfile,subprocess\nfrom pathlib import Path\np=Path(tempfile.mkdtemp(prefix='cockpit-autonomy-',dir='.cache')).resolve()/'journey'\nsubprocess.run(['python3','tests/rust_cockpit_autonomy.py','--binary',os.environ['SWARM_COCKPIT_BINARY'],'--legacy-binary',os.environ['SWARM_COCKPIT_LEGACY_BINARY'],'--profile-inputs',os.environ['SWARM_COCKPIT_PROFILE_INPUTS'],'--browser','--output',str(p)],check=True)\nprint('COCKPIT_AUTONOMY_EVIDENCE '+str(p))"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "COCKPIT_AUTONOMY_HISTORICAL_VERIFIED",
        "COCKPIT_AUTONOMY_PUBLIC_VERIFIED 20"
      ],
      "required_stderr": []
    }
  ]
}

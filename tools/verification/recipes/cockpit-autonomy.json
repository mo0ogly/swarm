{
  "schema_version": 1,
  "id": "cockpit-autonomy",
  "inputs": [
    "tests/rust_cockpit_autonomy.py",
    "tests/rust_cockpit_autonomy_ui.cjs",
    "tests/engine_settings_admin_choice_ui.cjs",
    "tests/helpers/engine_settings_admin_state.cjs",
    "tests/rust_native_http_cli.py",
    "tests/rust_agent_model_route.py",
    "rust/crates/swarm-engine/src/engine_settings.rs",
    "rust/crates/swarm-engine/src/engine_settings/cockpit_autonomy.rs",
    "rust/crates/swarm-engine/src/engine_settings_catalog.rs",
    "rust/crates/swarm-engine/src/mission_controls.rs",
    "rust/crates/swarm-engine/config/engine-settings*.json",

  ],
  "environment": {
    "CARGO_TARGET_DIR": "{root}/.cache/paea-verification-target",
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_INCREMENTAL": "0",
    "RUSTDOCFLAGS": "-D warnings"
  },
  "steps": [
    {
      "id": "no-implicit-journal-or-repository-adoption",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--test",
        "paea_git_repository",
        "git_repository_no_journal_never_adopts",
        "--message-format=json",
        "--",
        "--exact",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "test git_repository_no_journal_never_adopts ... ok",
        "1 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "five-private-binding-and-normal-library-format-cases",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--test",
        "paea_git_repository",
        "git_repository_",
        "--message-format=json",
        "--",
        "--ignored",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "test git_repository_provision_inspect_and_reopen ... ok",
        "test git_repository_exact_resource_candidate_and_roots_refuse ... ok",
        "test git_repository_rebinding_and_symlink_refuse_then_recover ... ok",
        "test git_repository_declaration_corruption_refuses_then_recovers ... ok",
        "5 passed; 0 failed",
        "test git_repository_normal_library_object_format_compatibility ... ok"
      ],
      "required_stderr": []
    },
    {
      "id": "owned-source-lane-rebinding-refusal-and-recovery",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--test",
        "paea_git_repository",
        "git_source_owned_lane_rebinding_and_recovery",
        "--message-format=json",
        "--",
        "--ignored",
        "--exact",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "test git_source_owned_lane_rebinding_and_recovery ... ok",
        "1 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "engine-rustdoc-contracts",
      "command": [
        "cargo",
        "doc",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--no-deps"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "Generated"
      ]
    }
  ]
}

      "command": [
        "python3",
        "-c",
        "import json,sys,subprocess,tempfile,hashlib,os; from pathlib import Path; base=Path(tempfile.mkdtemp(prefix='native-task-validation-',dir='.cache')).resolve(); scripts=[('happy','tests/rust_native_task_validation.py'),('recovery','tests/rust_native_task_validation_failures.py'),('output','tests/rust_native_task_validation_output.py'),('preview','tests/rust_native_task_validation_preview.py'),('ordinary','tests/rust_native_task_validation_ordinary.py'),('batch','tests/rust_native_task_validation_batch.py')]; source=Path(os.environ['SWARM_STATUS_CONTRACT_BINARY']).resolve(); raw=source.read_bytes(); sha=hashlib.sha256(raw).hexdigest(); binary=source; results={};\nfor name,script in scripts:\n out=base/name; subprocess.run([sys.executable,script,'--binary',str(binary),'--output',str(out)],check=True); result=json.loads((out/'result.json').read_text()); assert result['status']=='PASS'; results[name]=result\n(base/'result.json').write_text(json.dumps(dict(status='PASS',binary=str(binary),binary_sha256=sha,results=results),indent=2)+'\\n'); print('NATIVE_TASK_VALIDATION_PUBLIC_PASS '+str(base))"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "NATIVE_TASK_VALIDATION_PUBLIC_PASS"
      ],

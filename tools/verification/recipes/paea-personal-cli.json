{
  "schema_version": 1,
  "id": "paea-personal-cli",
  "inputs": [
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    ".cargo/config.toml",
    "rust/crates/**/*",
    "web/*",
    "web/lib/**/*",
    "web/paea-examples/v1/*.json",
    "frontend/engine-settings/*",
    "tools/agent-workflows/**/*",
    ".claude/skills/**/*",
    ".claude/commands/*.md",
    "contracts/*.json",
    "internal/engine/testdata/*.json",
    "tests/fixtures/*.json",
    "version_history.json",
    "tools/verification/recipe.py",
    "rust/crates/swarm-cli/tests/identity_control.rs",
    "tools/verification/recipes/paea-identity-options.json",
    "tests/fixtures/paea_personal_tty.py",
    "tests/fixtures/paea_personal_report_schema.py",
    "schemas/paea/personal-lifecycle-cli-v1.schema.json",
    "tools/verification/recipes/paea-personal-cli.json"
  ],
  "environment": {
    "CARGO_TARGET_DIR": "{root}/.cache/paea-verification-target",
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_INCREMENTAL": "0"
  },
  "steps": [

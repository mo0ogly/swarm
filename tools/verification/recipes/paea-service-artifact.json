{
  "schema_version": 1,
  "id": "paea-service-artifact",
  "inputs": [
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    ".cargo/config.toml",
    "rust/crates/swarm-enrollment-authority/**/*",
    "rust/crates/swarm-enrollment-bootstrap/**/*",
    "rust/crates/swarm-enrollment-config/**/*",
    "rust/crates/swarm-enrollment-proof/**/*",
    "rust/crates/swarm-enrollment-state/**/*",
    "rust/crates/swarm-identity-contract/**/*",
    "rust/crates/swarm-wire-json/**/*",
    "tools/verification/recipe.py",
    "tools/verification/recipes/paea-protected-signer.json",
    "tests/fixtures/paea_provisioning_request.json",
    "tools/verification/recipes/paea-service-artifact.json"
  ],
  "environment": {
    "CARGO_TARGET_DIR": "{root}/.cache/paea-contract-target"
  },
  "steps": [
    {
      "id": "service-only-frame-bindings-and-real-journal-recovery",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-enrollment-authority",
        "--test",
        "service_artifact",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "6 passed; 0 failed",
        "service_artifact_exact_roundtrip_excludes_operator_secrets_and_redacts",
        "service_artifact_codec_does_not_claim_signature_authority_real_journal_refuses"
      ],
      "required_stderr": []
    },
    {
      "id": "operator-private-package-publication-and-recovery",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-enrollment-authority",
        "--features",
        "test-fixtures",
        "--test",
        "operator_package",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "7 passed; 0 failed",
        "operator_package_matching_pin_malformed_payload_refuses_without_adoption",
        "operator_package_late_errors_preserve_visible_durable_and_exact_recovery"
      ],
      "required_stderr": []
    },
    {
      "id": "initial-material-journal-lifecycle",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-enrollment-authority",
        "--test",
        "provisioning",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "5 passed; 0 failed",
        "provisioning_material_drives_actual_cold_lifecycle_without_business_key"
      ],
      "required_stderr": []
    }
  ]
}

        "python3",
        "-c",
        "import os,tempfile,subprocess\nfrom pathlib import Path\np=Path(tempfile.mkdtemp(prefix='planning-history-final-',dir='.cache')).resolve()/'public-go'\nprint('RETAINED_FLOW',p,flush=True)\na=['python3','tests/rust_planning_history.py','--binary',os.environ['SWARM_STATUS_CONTRACT_BINARY'],'--output',str(p)]\na+=['--go-binary',os.environ['SWARM_GO_REFERENCE_BINARY']]\nsubprocess.run(a,check=True)"
      ],
      "expected_exit": 0,
      "required_stdout": [

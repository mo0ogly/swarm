{
  "schema_version": 1,
  "id": "paea-contract",
  "inputs": [
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    ".cargo/config.toml",
    "rust/crates/swarm-protection-contract/Cargo.toml",
    "rust/crates/swarm-protection-contract/src/*.rs",
    "rust/crates/swarm-protection-contract/tests/*.rs",
    "rust/crates/swarm-identity-contract/Cargo.toml",
    "rust/crates/swarm-identity-contract/src/*.rs",
    "rust/crates/swarm-cli/Cargo.toml",
    "rust/crates/swarm-cli/src/*.rs",
    "rust/crates/swarm-cli/src/*/*.rs",
    "rust/crates/swarm-cli/tests/protection.rs",
    "rust/crates/swarm-cli/tests/protection_receipt.rs",
    "tests/fixtures/paea/*.json",
    "schemas/paea/*.json",
    "tests/paea_contract_schema_test.py",
    "tools/paea/*.py",
    "tools/verification/recipe.py",
    "docs/architecture/PAEA-CONTRACT.md",
    "docs/en/PAEA-CONTRACT.md",
    "rust/crates/swarm-cli/tests/protection_receipt_report.rs",
    "rust/crates/swarm-web/Cargo.toml",
    "rust/crates/swarm-web/src/*.rs",
    "rust/crates/swarm-web/src/service/*.rs",
    "rust/crates/swarm-web/tests/paea.rs",
    "web/paea.*",
    "web/trust-native.html",
    "locales/en.json",
    "web/i18n*.js",
    "rust/crates/**/*",
    "web/*",
    "frontend/engine-settings/*",
    "tools/agent-workflows/**/*",
    ".claude/skills/**/*",
    "version_history.json",
    ".claude/commands/*.md",
    "contracts/*.json",
    "internal/engine/testdata/*.json",
    "tests/fixtures/*.json",
    "web/lib/**/*"
  ],
  "environment": {
    "CARGO_TARGET_DIR": "{root}/.cache/paea-contract-target"
  },
  "steps": [
    {
      "id": "schema-and-python-vectors",
      "command": [
        "python3",
        "tests/paea_contract_schema_test.py"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "Ran 5 tests",
        "OK",
        "test_schema_and_fourteen_both_domain_vectors"
      ],
      "required_stderr": []
    },
    {
      "id": "rust-contract",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-protection-contract",
        "--test",
        "contract",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "17 passed; 0 failed",
        "both_domains_match_precomputed_python_bytes_and_digests",
        "unknown_never_becomes_denial_retry_or_unobserved_success"
      ],
      "required_stderr": []
    },
    {
      "id": "rust-document-comparison",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-protection-contract",
        "--test",
        "comparison",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "3 passed; 0 failed",
        "compares_both_domains_without_authorizing",
        "transport_and_label_order_preserve_content_but_sources_do_not",
        "invalid_input_on_either_side_refuses_then_recovers"
      ],
      "required_stderr": []
    },
    {
      "id": "rust-receipt-correspondence",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-protection-contract",
        "--test",
        "receipt",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "4 passed; 0 failed",
        "exact_receipt_correspondence_in_both_domains_establishes_no_authenticity",
        "altered_action_intent_or_sink_refuses_with_control_and_recovery",
        "unknown_and_terminal_states_cannot_be_relabelled_or_replayed",
        "invalid_representation_or_expected_sink_never_yields_a_state"
      ],
      "required_stderr": []
    },
    {
      "id": "public-cli",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-cli",
        "--test",
        "protection",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "8 passed; 0 failed",
        "protection_output_failure_is_nonzero_without_project_side_effects",
        "protection_live_operations_are_not_advertised_as_implemented",
        "protection_comparison_both_domains_preserves_values_and_authority_boundary",
        "protection_comparison_fault_on_either_side_refuses_then_recovers",
        "protection_comparison_rejects_runtime_options_without_project_effects",
        "protection_comparison_output_failure_then_recovery"
      ],
      "required_stderr": []
    },
    {
      "id": "public-receipt-cli",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-cli",
        "--test",
        "protection_receipt",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "4 passed; 0 failed",
        "protection_receipt_both_domains_and_reconciliation_are_offline",
        "protection_receipt_invalid_inputs_and_bindings_refuse_then_recover",
        "protection_receipt_runtime_options_and_framing_refuse_before_reads",
        "protection_receipt_write_and_flush_failures_keep_cause_and_recover"
      ],
      "required_stderr": []
    },
    {
      "id": "rust-exact-receipt-report",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-protection-contract",
        "--test",
        "receipt_report",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "4 passed; 0 failed",
        "receipt_report_binds_observation_and_raw_bytes_without_authorizing",
        "receipt_report_transport_and_whitespace_do_not_change_business_identity",
        "receipt_report_rejects_bad_documents_and_receipts_then_recovers",
        "receipt_report_keeps_binding_and_lifecycle_refusals"
      ],
      "required_stderr": []
    },
    {
      "id": "public-exact-receipt-report",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-cli",
        "--test",
        "protection_receipt_report",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "3 passed; 0 failed",
        "protection_receipt_report_exact_files_and_legacy_shape_in_both_languages",
        "protection_receipt_report_refuses_invalid_inputs_and_runtime_then_recovers",
        "protection_receipt_report_writer_failure_then_recovery"
      ],
      "required_stderr": []
    },
    {
      "id": "native-paea-http",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-web",
        "--test",
        "paea",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "5 passed; 0 failed",
        "paea_http_exact_both_domains_and_unknown_are_data_only",
        "paea_http_refusal_recovery_and_private_menu_assets",
        "paea_payment_http_exact_resolution_and_integer_bytes_are_data_only",
        "paea_payment_http_refusals_recover_without_mutation",
        "paea_envelope_type_and_conflicting_duplicates_are_redacted_and_recover"
      ],
      "required_stderr": []
    }
  ]
}

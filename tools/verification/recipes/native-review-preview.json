    "docs/en/RUST-MIGRATION.md",
    "tests/rust_native_task_validation_failures.py",
    "tests/rust_native_task_validation_output.py",
    "tools/verification/recipes/native-task-validation.json",
    "tests/rust_native_task_validation_ordinary.py",
    "tests/rust_native_task_validation_source_compat.py",
    "tests/rust_native_task_validation_batch.py",
    "contracts/agent-wire-layout.v1.json",
    "tests/rust_native_review_preview.py"
  ],
  "environment": {
    "CARGO_TARGET_DIR": "{root}/rust/target/r97",
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_INCREMENTAL": "0",
    "RUSTDOCFLAGS": "-D warnings"
  },
  "steps": [
    {
      "id": "task-validation-unit",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--lib",
        "task_validation",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "8 passed; 0 failed",
        "wait_required_after_every_primitive_attempt_even_without_tuple_or_grant ... ok"
      ],
      "required_stderr": []
    },
    {
      "id": "normal-build",
      "command": [
        "cargo",
        "build",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-cli",
        "--message-format=json"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "compiler-artifact"
      ],
      "required_stderr": []
    },
    {
      "id": "public-task-validation",
      "command": [
        "python3",
        "-c",
        "import json,sys,subprocess,tempfile,hashlib,os; from pathlib import Path; base=Path(tempfile.mkdtemp(prefix='native-task-validation-',dir='.cache')).resolve(); scripts=[('happy','tests/rust_native_task_validation.py'),('recovery','tests/rust_native_task_validation_failures.py'),('output','tests/rust_native_task_validation_output.py'),('preview','tests/rust_native_task_validation_preview.py'),('ordinary','tests/rust_native_task_validation_ordinary.py'),('batch','tests/rust_native_task_validation_batch.py')]; source=Path('rust/target/r97/debug/swarm-rust').resolve(); raw=source.read_bytes(); sha=hashlib.sha256(raw).hexdigest(); binary=base/'swarm-rust'; stream=binary.open('xb'); stream.write(raw); stream.flush(); os.fsync(stream.fileno()); stream.close(); binary.chmod(0o700); assert hashlib.sha256(binary.read_bytes()).hexdigest()==sha; results={};\nfor name,script in scripts:\n out=base/name; subprocess.run([sys.executable,script,'--binary',str(binary),'--output',str(out)],check=True); result=json.loads((out/'result.json').read_text()); assert result['status']=='PASS'; results[name]=result\n(base/'result.json').write_text(json.dumps(dict(status='PASS',binary=str(binary),binary_sha256=sha,results=results),indent=2)+'\\n'); print('NATIVE_TASK_VALIDATION_PUBLIC_PASS '+str(base))"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "NATIVE_TASK_VALIDATION_PUBLIC_PASS"
      ],
      "required_stderr": []
    },
    {
      "id": "public-review-preview",
      "command": [
        "python3",
        "-c",
        "import tempfile,subprocess,sys; from pathlib import Path; base=Path(tempfile.mkdtemp(prefix='native-review-preview-',dir='.cache')).resolve(); subprocess.run([sys.executable,'tests/rust_native_review_preview.py','--binary',str(Path('rust/target/r97/debug/swarm-rust').resolve()),'--output',str(base/'public')],check=True); print('NATIVE_REVIEW_PREVIEW_RECIPE_PASS '+str(base))"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "NATIVE_REVIEW_PREVIEW_PUBLIC_PASS",
        "NATIVE_REVIEW_PREVIEW_RECIPE_PASS"
      ],
      "required_stderr": []
    },
    {
      "id": "clippy-native-cli",
      "command": [
        "cargo",
        "clippy",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-cli",
        "--bin",
        "swarm-rust",
        "--",
        "-D",
        "warnings"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "Finished"
      ]
    },
    {
      "id": "native-rustdoc",
      "command": [
        "cargo",
        "doc",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "-p",
        "swarm-cli",
        "--no-deps"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "Finished"
      ]
    }
  ]
}

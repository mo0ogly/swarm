{
  "schema_version": 1,
  "id": "paea-personal-credentials",
  "inputs": [
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    ".cargo/config.toml",
    "rust/crates/**/*",
    "web/*",
    "web/lib/**/*",
    "web/paea-examples/v1/*.json",
    "frontend/engine-settings/*",
    "tools/agent-workflows/**/*",
    ".claude/skills/**/*",
    ".claude/commands/*.md",
    "contracts/*.json",
    "internal/engine/testdata/*.json",
    "tests/fixtures/*.json",
    "version_history.json",
    "tools/verification/recipe.py"
  ],
  "environment": {
    "CARGO_TARGET_DIR": "{root}/.cache/paea-contract-target"
  },
  "steps": [
    {
      "id": "personal-credential-contract",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-enrollment-authority",
        "--test",
        "credentials",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "6 passed; 0 failed",
        "credential_real_argon2_roundtrip_proves_only_exact_password_record",
        "credential_independent_pin_context_principal_generation_refuse_before_hashing",
        "credential_explicit_documented_costs_roundtrip_and_preserve_typed_causes"
      ],
      "required_stderr": []
    },
    {
      "id": "control-core-regression",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-enrollment-authority",
        "--lib",
        "control::tests::",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "16 passed; 0 failed",
        "both_authority_and_storage_failures_survive_pending_exact_event_recovery"
      ],
      "required_stderr": []
    },
    {
      "id": "public-control-cli",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-cli",
        "--test",
        "identity_control",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "6 passed; 0 failed",
        "current_control_cli_observes_real_signed_enrollment_fr_en_without_authorizing_or_creating_project",
        "control_cli_revocation_and_real_sqlite_contention_refuse_and_explicit_recovery_works",
        "control_cli_bad_pin_unsafe_file_and_private_invalid_json_refuse_before_journal_access"
      ],
      "required_stderr": []
    }
  ]
}

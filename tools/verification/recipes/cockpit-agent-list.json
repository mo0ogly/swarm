        "import os,subprocess,tempfile\nfrom pathlib import Path\np=Path(tempfile.mkdtemp(prefix='cockpit-agent-list-',dir='.cache')).resolve()/'journey'\nsubprocess.run(['python3','tests/rust_cockpit_agent_list.py','--go-binary',os.environ['SWARM_COCKPIT_AGENT_LIST_GO_BINARY'],'--rust-binary',os.environ['SWARM_COCKPIT_AGENT_LIST_RUST_BINARY'],'--todo-dependencies','--output',str(p)],check=True)\nprint('COCKPIT_AGENT_LIST_EVIDENCE '+str(p))"

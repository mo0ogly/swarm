  "environment": {},
  "steps": [
    {
      "id": "planning-watch-evidence-guards",
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_rust_mission_watch_planning_guards.py",
        "-v"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "test_two_real_claim_witness",
        "test_wrong_scope_claim_input_and_revision_refuse",
        "OK",
        "test_terminal_replay_requires_real_work_after_valid_control",
        "test_backup_failure_preserves_original_and_partial_copy",
        "test_directory_sync_failure_is_not_swallowed",
        "test_backup_busy_locked_refuse_without_counter_success",
        "test_setting_count_string_control_refusal_recovery",
        "test_ancestor_activation_control_refusal_recovery",
        "test_move_only_swap_body_refusal_and_recovery",
        "test_move_only_install_rename_failures_restore_original",
        "test_move_only_sync_failures_restore_staged_original",
        "test_move_only_restore_refusal_preserves_original_then_recovers",
        "Ran 16 tests"
      ]
    },
    {
      "id": "shared-public-cleanup-ownership-and-terminal-race-guards",
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_rust_mission_watch_public_guards.py",
        "-v"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "test_cleanup_helper_live_terminal_and_replaced_stamp_are_distinct",
        "Ran 12 tests",
        "OK",
        "test_optional_idle_planning_exact_record_refusal_and_recovery"
      ]
    },
    {
      "id": "automatic-planning-through-inert-worker-completion",
      "command": [
        "python3",
        "-c",
        "import os,subprocess,tempfile\nfrom pathlib import Path\nbase=Path(tempfile.mkdtemp(prefix='mission-watch-planning-',dir='.cache')).resolve()\nsubprocess.run(['python3','tests/rust_mission_watch_planning.py','--binary',os.environ['SWARM_WATCH_PLANNING_BINARY'],'--profile',os.environ['SWARM_WATCH_PLANNING_PROFILE'],'--output',str(base/'run')],check=True)\nprint('REPLAY_EVIDENCE '+str(base))\n"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "PASS watch plans root child task and completes actual inert worker",
        "REPLAY_EVIDENCE",
        "PASS failed planner copied instance refuses before feedback then restores settlement"
      ],
      "required_stderr": []
    }
  ]
}

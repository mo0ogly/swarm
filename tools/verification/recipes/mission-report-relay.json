        "python3",
        "-c",
        "import os,subprocess,tempfile\nfrom pathlib import Path\nb=Path(tempfile.mkdtemp(prefix='mission-report-relay-',dir='.cache')).resolve()\nsubprocess.run(['python3','tests/rust_mission_report_relay.py','--binary',os.environ['SWARM_STATUS_CONTRACT_BINARY'],'--profile',os.environ['SWARM_STATUS_CONTRACT_PROFILE'],'--output',str(b/'run')],check=True)\nprint('REPLAY_EVIDENCE '+str(b))\n"
      ],
      "expected_exit": 0,

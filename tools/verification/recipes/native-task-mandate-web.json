    "tests/native_task_mandate_web.py",
    "tests/native_task_mandate.py",
    "tests/rust_agent_model_route.py",
    "tests/rust_trust_biba.py",
    "tests/rust_native_http_cli.py",
    "tests/fixture_area.py",
    "rust/crates/swarm-engine/config/engine-settings.json",
    "web/trust-native.html",
    "web/trust-native.js",
    "web/trust-native.css",

{
  "schema_version": 1,
  "id": "rust-graph-workbench",
  "inputs": [
    "tests/rust_graph_navigation.py",
    "tests/rust_graph_navigation_ui.cjs",
    "tests/rust_native_http_cli.py",
    "tests/rust_agent_model_route.py",
    "tests/fixture_area.py",
    "rust/crates/swarm-web/src/service.rs",
    "rust/crates/swarm-web/src/service/native_admin.rs",
    "rust/crates/swarm-web/tests/service.rs",
    "rust/crates/swarm-web/tests/server_transport.rs",
    "web/cockpit-native-graph.js",
    "web/cockpit-native.js",
    "web/graph.js",
    "web/graph.css",
    "web/swarm-design.css",
    "web/i18n-en.js",
    "locales/en.json",
    "docs/architecture/GRAPH-STUDIO.md",
    "docs/en/GRAPH-STUDIO.md",
    "version_history.json",
    "package-lock.json"
  ],
  "environment": {},
  "steps": [
    {
      "id": "native-graph-navigation-unchanged-work",
      "command": ["python3", "-c", "import os,subprocess,tempfile; from pathlib import Path; p=Path(tempfile.mkdtemp(prefix='graph-navigation-',dir='.cache')).resolve()/'journey'; subprocess.run(['python3','tests/rust_graph_navigation.py','--binary',os.environ['SWARM_GRAPH_BINARY'],'--output',str(p)],check=True); print('GRAPH_NAVIGATION_EVIDENCE '+str(p))"],
      "expected_exit": 0,
      "required_stdout": ["GRAPH_NAVIGATION_VERIFIED", "PASS fr-etat-background-panning", "PASS en-sombre-pointer-cancel-restores-card", "PASS en-sombre-modal-keyboard-contained", "PASS browser-no-unexpected-errors"],
      "required_stderr": []
    },
    {
      "id": "native-graph-create-links-refuse-cycle-and-recover",
      "command": ["python3", "-c", "import os,subprocess,tempfile; from pathlib import Path; p=Path(tempfile.mkdtemp(prefix='graph-editing-',dir='.cache')).resolve()/'journey'; subprocess.run(['python3','tests/rust_graph_navigation.py','--binary',os.environ['SWARM_GRAPH_BINARY'],'--output',str(p),'--editing'],check=True); print('GRAPH_EDITING_EVIDENCE '+str(p))"],
      "expected_exit": 0,
      "required_stdout": ["GRAPH_NAVIGATION_VERIFIED", "PASS fr-etat-task-create-acknowledged", "PASS en-sombre-keyboard-link-confirmed", "PASS en-sombre-cycle-refusal-preserves-work", "PASS en-sombre-creation-and-link-removal-persist", "PASS browser-no-unexpected-errors"],
      "required_stderr": []
    }
  ]
}

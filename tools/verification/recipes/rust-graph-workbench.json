    "tests/rust_graph_navigation.py",
    "tests/rust_graph_navigation_ui.cjs",
    "tests/rust_native_http_cli.py",
    "tests/rust_agent_model_route.py",
    "tests/fixture_area.py",
    "rust/crates/swarm-web/src/service.rs",
    "rust/crates/swarm-web/src/service/native_admin.rs",
    "rust/crates/swarm-web/tests/service.rs",
    "rust/crates/swarm-web/tests/server_transport.rs",

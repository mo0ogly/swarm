{
  "schema_version": 1,
  "id": "paea-initial-provisioning",
  "inputs": [
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    ".cargo/config.toml",
    "rust/crates/swarm-enrollment-authority/**/*",
    "rust/crates/swarm-enrollment-bootstrap/**/*",
    "rust/crates/swarm-enrollment-config/**/*",
    "rust/crates/swarm-enrollment-proof/**/*",
    "rust/crates/swarm-enrollment-state/**/*",
    "rust/crates/swarm-identity-contract/**/*",
    "rust/crates/swarm-wire-json/**/*",
    "tools/verification/recipe.py",
    "tools/verification/recipes/paea-protected-signer.json",
    "tests/fixtures/paea_provisioning_request.json",
    "tools/verification/recipes/paea-initial-provisioning.json"
  ],
  "environment": {
    "CARGO_TARGET_DIR": "{root}/.cache/paea-verification-target",
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_INCREMENTAL": "0"
  },
  "steps": [
    {
      "id": "initial-material-journal-lifecycle",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-enrollment-authority",
        "--test",
        "provisioning",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "5 passed; 0 failed",
        "provisioning_material_drives_actual_cold_lifecycle_without_business_key"
      ],
      "required_stderr": []
    },
    {
      "id": "entropy-and-private-output",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-enrollment-authority",
        "--lib",
        "provisioning::tests::",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "6 passed; 0 failed",
        "provisioning_partial_entropy_error_preserves_cause_without_retry",
        "provisioning_validation_precedes_entropy_for_all_operator_contracts",
        "provisioning_reserved_service_uid_refuses_before_entropy",
        "provisioning_reserved_controller_uid_refuses_before_entropy"
      ],
      "required_stderr": []
    },
    {
      "id": "protected-signer-private-files",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-enrollment-authority",
        "--lib",
        "protected_signer::tests::",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "8 passed; 0 failed",
        "protected_signer_actual_partial_read_preserves_eof_and_recovers",
        "protected_signer_read_stat_both_close_causes_and_recovery"
      ],
      "required_stderr": []
    },
    {
      "id": "two-source-authenticated-startup",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-enrollment-authority",
        "--features",
        "test-fixtures",
        "--test",
        "authenticated_startup",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "10 passed; 0 failed",
        "authenticated_startup_primary_business_refusal_and_actual_personal_close_fault_both_survive",
        "authenticated_startup_pinned_real_sources_execute_once_and_reopen"
      ],
      "required_stderr": []
    }
  ]
}

{
  "schema_version": 1,
  "id": "budget-history-rust",
  "inputs": [
    "rust/crates/swarm-engine/src/root_store/budget_history.rs",
    "rust/crates/swarm-engine/src/root_store.rs",
    "rust/crates/swarm-engine/src/lib.rs",

    {
      "id": "public-historical-budget",
      "command": [
        "python3",
        "-c",
        "import os,subprocess,tempfile\nfrom pathlib import Path\np=Path(tempfile.mkdtemp(prefix='budget-history-',dir='.cache')).resolve()/'journey'\nsubprocess.run(['python3','tests/rust_budget_history.py','--binary',os.environ['SWARM_BUDGET_HISTORY_BINARY'],'--output',str(p)],check=True)\nprint('BUDGET_HISTORY_EVIDENCE '+str(p))"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "PASS budget-history-show-envelope",
        "PASS budget-history-preview-no-mutation",
        "PASS budget-history-warning-consumed-40",
        "PASS budget-history-invalid-usage-recovery",
        "BUDGET_HISTORY_EVIDENCE"
      ],
      "required_stderr": []
    }
  ]

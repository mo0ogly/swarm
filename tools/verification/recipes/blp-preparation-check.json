{
  "schema_version": 1,
  "id": "blp-preparation-check",
  "inputs": [
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    "rust/crates/*/Cargo.toml",
    "rust/crates/*/src/**/*",
    "rust/crates/swarm-engine/config/**/*",
    "rust/crates/swarm-engine/tests/confidentiality.rs",
    "tools/verification/recipe.py",
    "docs/architecture/blp-flow-inventory.json",
    "rust/crates/swarm-engine/tests/preparation_worker_transport.rs"
  ],
  "environment": {
    "CARGO_TARGET_DIR": "{root}/.cache/blp-verification-target",
    "CARGO_INCREMENTAL": "0",
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_BUILD_JOBS": "1"
  },
  "steps": [
    {
      "id": "recorded-source-consumer",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--lib",
        "root_store::preparation_call::confidentiality_tests::recorded_sources_authentication_join_refusal_and_recovery",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "recorded_sources_authentication_join_refusal_and_recovery",
        "1 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "compiled-engine-source-bytes",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--lib",
        "engine_integrity_",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "engine_integrity_requires_current_instruction_bytes",
        "engine_integrity_attests_only_grammar_checked_framing",
        "2 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "typed-http-source-integrity-refusals",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-web",
        "--lib",
        "blp_preparation_status_preserves_refusal_and_internal_failures",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "blp_preparation_status_preserves_refusal_and_internal_failures",
        "1 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "malformed-index-http-refusal",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-web",
        "--lib",
        "malformed_engine_source_index_is_a_typed_bad_request",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "malformed_engine_source_index_is_a_typed_bad_request",
        "1 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "normal-turn-producer-engine-source",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--test",
        "preparation_worker_transport",
        "worker_gate_refuses_unauthorized_and_passes_bound_sends",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "worker_gate_refuses_unauthorized_and_passes_bound_sends",
        "1 passed; 0 failed"
      ],
      "required_stderr": []
    }
  ]
}

    "tests/rust_native_quotas.py",
    "tests/rust_native_quotas_ui.cjs"
  ],
  "environment": {
    "CARGO_TARGET_DIR": "{root}/rust/target/r97",
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_INCREMENTAL": "0",
    "RUSTDOCFLAGS": "-D warnings"
  },
  "steps": [
    {
      "id": "quota-data-and-saved-policy",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--test",
        "quotas",
        "--test",
        "engine_settings_catalog",
        "--test",
        "engine_settings",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "7 passed; 0 failed",
        "1 passed; 0 failed",
        "quota_saved_reason_policy_is_effective_and_legacy_absence_refuses ... ok",
        "quota_scope_zero_restores_inheritance_without_bypassing_ancestor_budget ... ok",
        "catalog_covers_all_actual_values_and_nullable_fields_match_authoritative_validation ... ok",
        "4 passed; 0 failed",
        "preview_is_pure_apply_requires_exact_token_and_replay_does_not_add_history ... ok"
      ],
      "required_stderr": []
    },
    {
      "id": "quota-transaction",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--test",
        "work_engine",
        "quotas_transaction_rollback_replay_and_policy",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "quotas_transaction_rollback_replay_and_policy ... ok",
        "1 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "quota-url",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-web",
        "--lib",
        "quota_",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "quota_work_query_refuses_ambiguity_without_default ... ok",
        "quota_status_preserves_client_conflict_and_internal_failures ... ok",
        "2 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "native-admin-asset-guards",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-web",
        "--test",
        "native_admin",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "2 passed; 0 failed",
        "native_admin_landing_and_assets_are_protected_without_secret_or_path_fallback ... ok",
        "native_admin_assets_keep_host_csrf_method_and_no_mutation_contract ... ok"
      ],
      "required_stderr": []
    },
    {
      "id": "native-build",
      "command": [
        "cargo",
        "build",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-cli",
        "--bin",
        "swarm-rust"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "Finished"
      ]
    },
    {
      "id": "native-lint",
      "command": [
        "cargo",
        "clippy",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "-p",
        "swarm-web",
        "-p",
        "swarm-cli",
        "--lib",
        "--",
        "-D",
        "warnings"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "Finished"
      ]
    },
    {
      "id": "native-doc",
      "command": [
        "cargo",
        "doc",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "-p",
        "swarm-web",
        "-p",
        "swarm-cli",
        "--no-deps"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "Finished"
      ]
    },
    {
      "id": "native-http-js",
      "command": [
        "node",
        "tests/native_settings_http_adapter_test.cjs"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "PASS native HTTP adapter 5 cases"
      ],
      "required_stderr": []
    },
    {
      "id": "actual-native-role-contexts",
      "command": [
        "python3",
        "tools/agent-workflows/check.py"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "4 native roles, 9 named native tests",
        "frozen_role_planner_contract ... ok",
        "frozen_role_subplanner_contract ... ok",
        "frozen_role_worker_contract ... ok",
        "frozen_role_reviewer_contract ... ok"
      ],
      "required_stderr": []
    },
    {
      "id": "public-cli-http",
      "command": [
        "python3",
        "-c",
        "import tempfile,subprocess,sys,json,os,hashlib; from pathlib import Path; base=Path(tempfile.mkdtemp(prefix='native-quotas-cli-http-',dir='.cache')).resolve(); source=Path('rust/target/r97/debug/swarm-rust'); raw=source.read_bytes(); binary=base/'swarm-rust'; stream=binary.open('xb'); stream.write(raw); stream.flush(); os.fsync(stream.fileno()); stream.close(); binary.chmod(0o700); assert hashlib.sha256(binary.read_bytes()).digest()==hashlib.sha256(raw).digest(); subprocess.run([sys.executable,'tests/rust_native_quotas.py','--binary',str(binary),'--output',str(base/'public')],check=True); result=json.loads((base/'public/result.json').read_bytes()); assert result['status']=='PASS'; print('NATIVE_QUOTAS_PUBLIC_REPLAY_PASS'+' '+str(base))"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "NATIVE_QUOTAS_PUBLIC_REPLAY_PASS"
      ],
      "required_stderr": []
    },
    {
      "id": "public-browser",
      "command": [
        "python3",
        "-c",
        "import tempfile,subprocess,sys,json,os,hashlib; from pathlib import Path; base=Path(tempfile.mkdtemp(prefix='native-quotas-browser-',dir='.cache')).resolve(); source=Path('rust/target/r97/debug/swarm-rust'); raw=source.read_bytes(); binary=base/'swarm-rust'; stream=binary.open('xb'); stream.write(raw); stream.flush(); os.fsync(stream.fileno()); stream.close(); binary.chmod(0o700); assert hashlib.sha256(binary.read_bytes()).digest()==hashlib.sha256(raw).digest(); subprocess.run([sys.executable,'tests/rust_native_login_browser.py','--binary',str(binary),'--output',str(base/'public'),'--scenario','quotas'],check=True); result=json.loads((base/'public/result.json').read_bytes()); assert result['status']=='PASS'; print('NATIVE_QUOTAS_BROWSER_REPLAY_PASS'+' '+str(base))"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "NATIVE_QUOTAS_BROWSER_REPLAY_PASS"
      ],
      "required_stderr": []
    },
    {
      "id": "i18n-contract",
      "command": [
        "npm",
        "run",
        "test:i18n"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "PASS"
      ],
      "required_stderr": []
    }
  ]
}

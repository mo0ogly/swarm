{
  "schema_version": 1,
  "id": "blp-preparation-worker-gate",
  "inputs": [
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    "rust/crates/*/Cargo.toml",
    "rust/crates/swarm-engine/config/**/*",
    "tools/verification/recipe.py",
    "rust/crates/swarm-confidentiality/src/**/*",
    "rust/crates/swarm-engine/src/**/*",
    "rust/crates/swarm-engine/tests/preparation_calls.rs",
    "rust/crates/swarm-engine/tests/preparation_transport.rs",
    "rust/crates/swarm-engine/tests/preparation_worker_transport.rs",
    "rust/crates/swarm-identity-contract/src/**/*",
    "rust/crates/swarm-wire-json/src/**/*",
    "rust/crates/swarm-cli/src/**/*"
  ],
  "environment": {
    "CARGO_TARGET_DIR": "{root}/.cache/blp-verification-target",
    "CARGO_INCREMENTAL": "0",
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_BUILD_JOBS": "1"
  },
  "steps": [
    {
      "id": "worker-gate-rejections-and-legacy-fast-path",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--test",
        "preparation_worker_transport",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "worker_gate_refuses_unauthorized_and_passes_bound_sends",
        "1 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "neighbor-producer-and-decision-regressions",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--test",
        "preparation_calls",
        "--test",
        "preparation_transport",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "confidential_admission_is_fixed_authenticated_and_never_dispatchable",
        "transport_decision_is_fixed_authorized_and_never_emissive",
        "0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "cli-worker-compiles-with-gate-threading",
      "command": [
        "cargo",
        "check",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-cli"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": ["Finished `dev` profile"]
    }
  ]
}

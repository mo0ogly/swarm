        "-c",
        "import sys,json,tempfile,subprocess; from pathlib import Path\nbase=Path(tempfile.mkdtemp(prefix='native-planning-http-',dir='.cache')).resolve()\nsubprocess.run([sys.executable,'tools/verification/verify_native_profile.py','--output',str(base/'profile')],check=True)\np=json.loads((base/'profile/result.json').read_bytes());binary=str(Path(p['binary']).resolve())\nsubprocess.run([sys.executable,'tests/rust_native_planning_http.py','--binary',binary,'--profile',str(base/'profile/result.json'),'--output',str(base/'http')],check=True)\nsubprocess.run([sys.executable,'tests/rust_native_http_cli.py','--binary',binary,'--output',str(base/'driver')],check=True)\nassert all(json.loads((base/n/'result.json').read_bytes())['status']=='PASS' for n in ['http','driver'])\nprint('REPLAY_EVIDENCE '+str(base))"
      ],

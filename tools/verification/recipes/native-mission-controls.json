        "-c",
        "import sys,json,tempfile,subprocess; from pathlib import Path\nbase=Path(tempfile.mkdtemp(prefix='native-mission-controls-',dir='.cache')).resolve()\nsubprocess.run([sys.executable,'tools/verification/verify_native_profile.py','--output',str(base/'profile')],check=True)\np=json.loads((base/'profile/result.json').read_bytes());binary=str(Path(p['binary']).resolve());common=['--binary',binary,'--profile',str(base/'profile/result.json')]\nfor script,name in [('rust_native_mission_controls.py','controls'),('rust_native_mission_pause_held.py','held'),('rust_native_mission_output.py','output'),('rust_native_planning_http.py','http'),('rust_native_mission_start.py','start'),('rust_native_review_mission_pause.py','review-pause')]:\n subprocess.run([sys.executable,'tests/'+script]+common+['--output',str(base/name)],check=True)\nsubprocess.run([sys.executable,'tests/rust_native_mission_output_replay.py']+common+['--original-proof',str(base/'output'),'--output',str(base/'replay')],check=True)\nsubprocess.run([sys.executable,'-m','unittest','discover','-s','tests','-p','test_sdk_artifact_depfiles.py','-v'],check=True)\nassert all(json.loads((base/n/'result.json').read_bytes())['status']=='PASS' for n in ['controls','held','output','http','start','review-pause','replay'])\nprint('REPLAY_EVIDENCE '+str(base))"
      ],

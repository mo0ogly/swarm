{
  "schema_version": 1,
  "id": "paea-approval-check",
  "inputs": [
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    ".cargo/config.toml",
    "rust/crates/swarm-protection-contract/Cargo.toml",
    "rust/crates/swarm-protection-contract/src/*.rs",
    "rust/crates/swarm-protection-contract/tests/*.rs",
    "rust/crates/swarm-identity-contract/Cargo.toml",
    "rust/crates/swarm-identity-contract/src/*.rs",
    "rust/crates/swarm-cli/Cargo.toml",
    "rust/crates/swarm-cli/src/*.rs",
    "rust/crates/swarm-cli/src/*/*.rs",
    "rust/crates/swarm-cli/tests/protection.rs",
    "rust/crates/swarm-cli/tests/protection_receipt.rs",
    "tests/fixtures/paea/*.json",
    "schemas/paea/*.json",
    "tests/paea_contract_schema_test.py",
    "tools/paea/*.py",
    "tools/verification/recipe.py",
    "docs/architecture/PAEA-CONTRACT.md",
    "docs/en/PAEA-CONTRACT.md",
    "rust/crates/swarm-cli/tests/protection_receipt_report.rs",
    "rust/crates/swarm-web/Cargo.toml",
    "rust/crates/swarm-web/src/*.rs",
    "rust/crates/swarm-web/src/service/*.rs",
    "rust/crates/swarm-web/tests/paea.rs",
    "web/paea.*",
    "web/trust-native.html",
    "locales/en.json",
    "web/i18n*.js",
    "rust/crates/**/*",
    "web/*",
    "frontend/engine-settings/*",
    "tools/agent-workflows/**/*",
    ".claude/skills/**/*",
    "version_history.json",
    "tests/paea_payment_schema_test.py",
    "web/paea-payment.html",
    ".claude/commands/*.md",
    "contracts/*.json",
    "internal/engine/testdata/*.json",
    "tests/fixtures/*.json",
    "web/lib/**/*",
    "tests/paea_comparison_http_schema_test.py",
    "web/paea-compare.html",
    "web/paea-examples/v1/*.json",
    "tests/paea_examples_test.py",
    "tools/paea/make_examples.py",
    "web/paea-inspect.html",
    "rust/crates/swarm-cli/tests/protection_inspection.rs",
    "tests/paea_inspection_schema_test.py",
    "rust/crates/swarm-protection-contract/tests/inspection.rs",
    "tests/paea_approval_schema_test.py",
    "rust/crates/swarm-cli/tests/protection_approval.rs",
    "web/paea-approval.html"
  ],
  "environment": {
    "CARGO_TARGET_DIR": "{root}/.cache/paea-contract-target"
  },
  "steps": [
    {
      "id": "approval-shapes",
      "command": [
        "python3",
        "tests/paea_approval_schema_test.py"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "Ran 2 tests",
        "OK"
      ],
      "required_stderr": []
    },
    {
      "id": "approval-core",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-protection-contract",
        "--test",
        "approval",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "3 passed; 0 failed",
        "approval_all_vectors_match_exact_inputs_without_establishing_authority",
        "approval_distinguishes_content_policy_attempt_and_untrusted_approver",
        "approval_strict_refusals_retain_cause_and_recover_without_partial_report"
      ],
      "required_stderr": []
    },
    {
      "id": "approval-cli",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-cli",
        "--test",
        "protection_approval",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "2 passed; 0 failed",
        "approval_cli_matches_shared_bytes_for_match_and_mismatch_without_root",
        "approval_cli_refuses_invalid_inputs_and_options_then_recovers_exactly"
      ],
      "required_stderr": []
    },
    {
      "id": "approval-http",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-web",
        "--test",
        "paea",
        "paea_approval_http_",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "2 passed; 0 failed",
        "paea_approval_http_matches_shared_report_and_private_examples_without_root_mutation",
        "paea_approval_http_refusals_keep_causes_and_recover_without_partial_report"
      ],
      "required_stderr": []
    },
    {
      "id": "ten-examples",
      "command": [
        "python3",
        "tools/paea/make_examples.py",
        "--check"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "CHECK payment-approval.json",
        "CHECK git-approval.json",
        "CHECK payment-request.json"
      ],
      "required_stderr": []
    },
    {
      "id": "five-disclosures",
      "command": [
        "python3",
        "tests/paea_examples_test.py"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "test_all_ten_fictional_files_have_the_declared_data_shape",
        "test_all_five_disclosures_link_only_exact_versioned_downloads_with_english",
        "Ran 2 tests",
        "OK"
      ],
      "required_stderr": []
    }
  ]
}

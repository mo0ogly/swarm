      "command": [
        "python3",
        "-c",
        "import os,subprocess,tempfile\nfrom pathlib import Path\nbase=Path(tempfile.mkdtemp(prefix='mission-root-instance-',dir='.cache')).resolve()\nsubprocess.run(['python3','tests/rust_mission_root_instance.py','--binary',os.environ['SWARM_ROOT_INSTANCE_BINARY'],'--profile',os.environ['SWARM_ROOT_INSTANCE_PROFILE'],'--sdk-binary',os.environ['SWARM_ROOT_INSTANCE_SDK_BINARY'],'--sdk-profile',os.environ['SWARM_ROOT_INSTANCE_SDK_PROFILE'],'--expected-binding-version',os.environ.get('SWARM_ROOT_INSTANCE_EXPECTED_BINDING_VERSION','4'),'--variant',os.environ.get('SWARM_ROOT_INSTANCE_VARIANT','directory'),'--probe-schema-version',os.environ.get('SWARM_ROOT_INSTANCE_PROBE_SCHEMA_VERSION','2'),'--instance-refusal-code',os.environ.get('SWARM_ROOT_INSTANCE_REFUSAL_CODE',''),'--output',str(base/'run')],check=True)\nprint('REPLAY_EVIDENCE '+str(base))\n"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "PASS same post-dispatch hook executes original Root and completes",
        "PASS substituted Root instance refuses with exact code; OS reap, restoration and public cancellation verified",
        "REPLAY_EVIDENCE"
      ],
      "required_stderr": []
    }

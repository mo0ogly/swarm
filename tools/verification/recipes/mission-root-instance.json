        "discover",
        "-s",
        "tests",
        "-p",
        "test_rust_mission_root_instance_guards.py",
        "-v"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "test_probe_zombie_is_kernel_owned_and_never_claims_reobserved_executable",
        "test_sdk_context_classification_requires_every_exact_branch_and_phase",

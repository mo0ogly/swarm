    "tools/agent-workflows/templates/HANDOFF.md",
    "tools/agent-workflows/templates/QUALITY.md",
    "tools/agent-workflows/templates/TRACKING.md",
    "tools/agent-workflows/templates/preparations.json",
    "rust/crates/swarm-linux-prerequisites/**/*",
    "rust/crates/swarm-biba-linux/Cargo.toml",
    "rust/crates/swarm-biba-linux/src/lib.rs",
    "rust/crates/swarm-api-client/Cargo.toml",
    "rust/crates/swarm-api-client/src/lib.rs",
    "rust/crates/swarm-cli/Cargo.toml",
    "rust/crates/swarm-cli/src/lib.rs",
    "rust/crates/swarm-cli/src/main.rs",
    "rust/crates/swarm-cli/examples/legacy_mission_intent.rs",
    "rust/crates/swarm-cli/examples/legacy_v2_mission_intent.rs",
    "rust/crates/swarm-cli/examples/mission_fifo_completion_failure.rs",

    "rust/crates/swarm-cli/examples/mission_worker_adoption_refusals.rs",
    "rust/crates/swarm-cli/examples/mission_worker_dispatch.rs",
    "rust/crates/swarm-cli/examples/workspace_fifo_admission.rs",
    "rust/crates/swarm-web/Cargo.toml",
    "rust/crates/swarm-web/src/lib.rs",
    ".claude/commands/ks-feature.md",
    ".claude/commands/ks-plan.md",
    ".claude/skills/apex/SKILL.md",
    ".claude/skills/audit-pdca/SKILL.md",
    ".claude/skills/code-reviewer/SKILL.md",
    ".claude/skills/debug/SKILL.md",
    ".claude/skills/product-delivery/SKILL.md",
    ".claude/skills/product-planning/SKILL.md",
    ".claude/skills/product-review/SKILL.md",
    ".claude/skills/replan/SKILL.md",
    ".claude/skills/spec-audit/SKILL.md",
    ".claude/skills/spec-builder/SKILL.md",
    ".claude/skills/verify-fix/SKILL.md",
    "config/activity-policy.json",
    "config/graph-performance.json",
    "config/log-read-policy.json",
    "config/provider-wait.json",
    "config/web-requests.json",
    "contracts/work-request-fields.v1.json",
    "internal/engine/testdata/legacy-blank-work-56.json",
    "internal/engine/testdata/legacy-ignored-request-55.json",
    "locales/en.json",
    "tests/fixtures/native-review-public-v1.json",
    "tests/fixtures/paea/contract-v1.json",
    "tests/fixtures/paea/payment-registry-v1.json",
    "tests/fixtures/paea/payment-request-v1.json",
    "tests/fixtures/paea_namespace_owner.py",
    "tests/fixtures/terminal_clip_go047.json",
    "version_history.json",
    "docs/architecture/PAEA-GIT-TRANSACTION.md",
    "docs/en/PAEA-GIT-TRANSACTION.md",
    "tools/verification/README.md",
    "tests/rust_native*.py",
    "tests/paea_historical_publication_test.py",
    "docs/architecture/NATIVE-REVIEWER.md",
    "docs/en/NATIVE-REVIEWER.md",
    "tools/verification/recipes/paea-git-writer-format.json"
  ],
  "environment": {
    "CARGO_TARGET_DIR": "{root}/.cache/paea-verification-target",
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_INCREMENTAL": "0",
    "RUSTDOCFLAGS": "-D warnings"
  },
  "steps": [
    {
      "id": "actual-sqlite-writer-refusal-lock-and-recovery",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--lib",
        "root_store::paea_git_repository::barrier_tests::writer_requires_actual_write_and_recovers",
        "--message-format=json",
        "--",
        "--exact",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "test root_store::paea_git_repository::barrier_tests::writer_requires_actual_write_and_recovers ... ok",
        "1 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "actual-native-writer-and-private-git-format-before-intent",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--lib",
        "root_store::paea_git_repository::barrier_tests::",
        "--message-format=json",
        "--",
        "--ignored",
        "--nocapture",
        "--test-threads=1"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "test root_store::paea_git_repository::barrier_tests::writer_native_candidate_and_binding_share_transaction ... ok",
        "test root_store::paea_git_repository::barrier_tests::object_format_compatibility_refuses_before_intent ... ok",
        "2 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "engine-rustdoc-contracts",
      "command": [
        "cargo",
        "doc",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--no-deps"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "Generated"
      ]
    }
  ]
}

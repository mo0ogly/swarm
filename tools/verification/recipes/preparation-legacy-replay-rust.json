    "rust/crates/swarm-cli/Cargo.toml",
    "rust/crates/swarm-cli/src/preparation.rs",
    "rust/crates/swarm-cli/src/preparation_worker.rs",
    "rust/crates/swarm-cli/src/lib.rs",
    "rust/crates/swarm-web/src/service.rs",
    "rust/crates/swarm-web/src/service/preparations.rs",
    "web/preparation-native.js",
    "web/preparation-native-dialogue.js",
    "web/prephase-dialogue.js",
    "web/prepare.html",
    "web/i18n-en.js",
    "locales/en.json",
    "tests/rust_preparation_calls.py",
    "tests/rust_preparation_calls_ui.cjs",
    "tests/rust_agent_model_route.py",
    "tests/rust_native_http_cli.py",
    "docs/plans/migration-rust/PREPARATION-AI-CALLS-20261026.md",

{
  "schema_version": 1,
  "id": "paea-pilot-lab",
  "inputs": [
    "tools/paea/pilot_lab.py",
    "tools/paea/pilot_oracle.py",
    "tests/paea_pilot_lab_test.py",
    "tests/fixtures/paea/contract-v1.json",
    "docs/plans/actions-confiance/paea/PILOTE-OPERATIONNEL.md",
    "docs/en/plans/actions-confiance/paea/OPERATIONAL-PILOT.md",
    "rust/crates/swarm-protection-contract/src/*.rs",
    "rust/crates/swarm-cli/src/protection.rs",
    "tests/fixtures/paea/payment-*.json",
    "tools/paea/run_pilot.py",
    "tests/helpers/paea_pilot_contention.py"
  ],
  "environment": {
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "steps": [
    {
      "id": "isolated-effect-scenarios",
      "command": [
        "python3",
        "tests/paea_pilot_lab_test.py"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "Ran 8 tests",
        "OK",
        "test_t04_substitution_then_equivalent_json_recovery",
        "test_t06_t21_crash_new_attempt_exact_marker_and_reconciliation",
        "test_t05_t17_ordered_revocation_first_use_and_opposite_order",
        "test_unavailable_oracle_stays_unknown_then_recovers_without_creation",
        "test_git_stale_and_symbolic_target_refuse_then_recover",
        "test_output_failure_after_effect_is_unknown_and_reconciles",
        "test_invoice_alias_is_a_counterexample_without_authoritative_registry",
        "PAEA_GUIDE_03_COUNTEREXAMPLE_RETAINED",
        "PAEA_PILOT_BINARY_STABLE",
        "test_resolved_invoice_aliases_converge_on_one_effect",
        "PAEA_GUIDE_03_RESOLVED_FIXTURE",
        "PAEA_CONTENTION_PASS payment owner=commit explicit-recovery",
        "PAEA_CONTENTION_PASS payment owner=revoke explicit-recovery",
        "PAEA_CONTENTION_PASS git owner=commit explicit-recovery",
        "PAEA_CONTENTION_PASS git owner=revoke explicit-recovery"
      ],
      "required_stderr": []
    }
  ]
}

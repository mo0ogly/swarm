{
  "schema_version": 1,
  "id": "paea-personal-bootstrap",
  "inputs": [
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    ".cargo/config.toml",
    "rust/crates/swarm-enrollment-authority/**/*",
    "rust/crates/swarm-enrollment-bootstrap/**/*",
    "rust/crates/swarm-enrollment-config/**/*",
    "rust/crates/swarm-enrollment-proof/**/*",
    "rust/crates/swarm-enrollment-state/**/*",
    "rust/crates/swarm-identity-contract/**/*",
    "rust/crates/swarm-wire-json/**/*",
    "tools/verification/recipe.py"
  ],
  "environment": {
    "CARGO_TARGET_DIR": "{root}/.cache/paea-contract-target"
  },
  "steps": [
    {
      "id": "personal-credential-contract",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-enrollment-authority",
        "--test",
        "credentials",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "6 passed; 0 failed",
        "credential_real_argon2_roundtrip_proves_only_exact_password_record",
        "credential_independent_pin_context_principal_generation_refuse_before_hashing",
        "credential_explicit_documented_costs_roundtrip_and_preserve_typed_causes"
      ],
      "required_stderr": []
    },
    {
      "id": "signed-atomic-batch",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-enrollment-state",
        "--test",
        "batch",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "4 passed; 0 failed",
        "single_apply_preserves_base_frame_closed_then_cancellation_refusal_order"
      ],
      "required_stderr": []
    },
    {
      "id": "one-time-personal-source",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-enrollment-authority",
        "--test",
        "personal",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "5 passed; 0 failed",
        "personal_post_usage_cancellation_retains_success_or_failure_outcome_without_relabeling_effect"
      ],
      "required_stderr": []
    },
    {
      "id": "journal-single-event-regression",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-enrollment-state",
        "--test",
        "journal",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "9 passed; 0 failed",
        "corrupt_history_keeps_the_original_rejection_cause"
      ],
      "required_stderr": []
    },
    {
      "id": "retained-journal-regression",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-enrollment-state",
        "--test",
        "bound",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "3 passed; 0 failed",
        "retained_connection_never_reopens_replaced_path"
      ],
      "required_stderr": []
    },
    {
      "id": "control-core-regression",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "-p",
        "swarm-enrollment-authority",
        "--lib",
        "control::tests::",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "16 passed; 0 failed",
        "both_authority_and_storage_failures_survive_pending_exact_event_recovery"
      ],
      "required_stderr": []
    }
  ]
}

        "-c",
        "import os,subprocess,tempfile,sys\nif sys.flags.optimize != 0:raise ValueError('historical verification requires Python assertions enabled')\nfrom pathlib import Path\nbase=Path(tempfile.mkdtemp(prefix='mission-legacy-v1-',dir='.cache')).resolve()\nprint('REPLAY_EVIDENCE '+str(base),flush=True)\nargs=['python3','tests/rust_mission_legacy_intent.py','--binding-schema','1']\nfor key,var in [('binary', 'SWARM_LEGACY_NEW_BINARY'), ('profile', 'SWARM_LEGACY_NEW_PROFILE'), ('old-binary', 'SWARM_LEGACY_OLD_BINARY'), ('old-profile', 'SWARM_LEGACY_OLD_PROFILE'), ('legacy-sdk', 'SWARM_LEGACY_SDK'), ('legacy-profile', 'SWARM_LEGACY_SDK_PROFILE'), ('current-sdk', 'SWARM_LEGACY_CURRENT_SDK'), ('current-sdk-profile', 'SWARM_LEGACY_CURRENT_SDK_PROFILE'), ('old-helpers-manifest', 'SWARM_LEGACY_HELPERS_MANIFEST'), ('old-helpers-root', 'SWARM_LEGACY_HELPERS_ROOT')]:\n value=Path(os.environ[var]).resolve()\n if not value.exists():raise ValueError('legacy-input-missing:'+var)\n args+=['--'+key,str(value)]\nsubprocess.run(args+['--output',str(base/'run')],check=True)\n"
      ],

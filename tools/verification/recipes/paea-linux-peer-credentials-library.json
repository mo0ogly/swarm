{
  "schema_version": 1,
  "id": "paea-linux-peer-credentials-library",
  "inputs": [
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    ".cargo/config.toml",
    "rust/crates/swarm-engine/**/*",
    "rust/crates/swarm-cli/**/*",
    "rust/crates/swarm-enrollment-authority/**/*",
    "rust/crates/swarm-enrollment-config/**/*",
    "rust/crates/swarm-enrollment-state/**/*",
    "rust/crates/swarm-enrollment-proof/**/*",
    "rust/crates/swarm-identity-contract/**/*",
    "rust/crates/swarm-wire-json/**/*",
    "rust/crates/swarm-enrollment-bootstrap/**/*",
    "tests/paea_linux_peer_credentials_test.py",
    "tools/verification/recipes/paea-linux-peer-credentials-library.json",
    "tools/verification/recipe.py"
  ],
  "environment": {
    "CARGO_TARGET_DIR": "{root}/.cache/paea-verification-target",
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_INCREMENTAL": "0",
    "RUSTDOCFLAGS": "-D warnings"
  },
  "steps": [
    {
      "id": "actual-safe-raw-credentials-invalid-data-and-diagnostics",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--lib",
        "linux_peer_credentials::tests::",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "4 passed; 0 failed",
        "unconnected_pid_zero_refuses_without_errno_zero_then_connected_recovers",
        "peer_diagnostics_keep_raw_invalid_separate_from_syscall_failure"
      ],
      "required_stderr": []
    },
    {
      "id": "operator-error-traversal-remains-complete",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-cli",
        "--lib",
        "identity_service_call::tests::",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "6 passed; 0 failed",
        "service_call_custom_io_keeps_after_use_storage_and_both_close_branches"
      ],
      "required_stderr": []
    },
    {
      "id": "private-peer-boundary-engine-rustdoc",
      "command": [
        "cargo",
        "doc",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--no-deps",
        "--document-private-items"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "Finished"
      ]
    }
  ]
}

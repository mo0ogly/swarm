  "steps": [
    {
      "id": "valid-durable-intent-control-before-faults",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--test",
        "paea_git_intent",
        "git_intent_durable_alias_conflict_and_restart",
        "--message-format=json",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "test git_intent_durable_alias_conflict_and_restart ... ok",
        "1 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "six-durable-intent-cases-uncertainty-race-and-recovery",

        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--test",
        "paea_git_intent",
        "--message-format=json",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "test git_intent_durable_alias_conflict_and_restart ... ok",
        "test git_intent_refusals_preserve_original_and_recover ... ok",
        "test git_intent_commit_uncertain_then_read_and_recover ... ok",
        "test git_intent_corrupt_record_refuses_and_recovers ... ok",
        "6 passed; 0 failed",
        "test git_intent_two_connections_have_one_new_reservation ... ok",
        "test git_intent_schema_change_refuses_and_recovers ... ok"
      ],
      "required_stderr": []
    },
    {

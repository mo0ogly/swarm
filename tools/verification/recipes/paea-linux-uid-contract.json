{
  "schema_version": 1,
  "id": "paea-linux-uid-contract",
  "inputs": [
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    ".cargo/config.toml",
    "rust/crates/swarm-enrollment-authority/**/*",
    "rust/crates/swarm-enrollment-bootstrap/**/*",
    "rust/crates/swarm-enrollment-config/**/*",
    "rust/crates/swarm-enrollment-proof/**/*",
    "rust/crates/swarm-enrollment-state/**/*",
    "rust/crates/swarm-identity-contract/**/*",
    "rust/crates/swarm-wire-json/**/*",
    "rust/crates/swarm-linux-identity-channel/**/*",
    "tests/fixtures/paea_provisioning_request.json",
    "go.mod",
    "go.sum",
    "internal/identitycontract/*.go",
    "internal/enrollmentbootstrap/*.go",
    "internal/enrollmentconfig/*.go",
    "tools/verification/recipe.py",
    "tools/verification/recipes/paea-linux-uid-contract.json"
  ],
  "environment": {
    "CARGO_TARGET_DIR": "{root}/.cache/paea-verification-target",
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_INCREMENTAL": "0",
    "RUSTDOCFLAGS": "-D warnings"
  },
  "steps": [
    {
      "id": "go-numeric-roles-and-actual-bootstrap-recovery",
      "command": [
        "go",
        "test",
        "-timeout=0",
        "./internal/identitycontract",
        "./internal/enrollmentbootstrap",
        "-v"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "TestLinuxUIDRepresentationRefusesOnlyReservedSentinel",
        "--- PASS: TestBootstrapReservedUIDsRefuseAfterNumericWitness",
        "--- PASS: TestFixtureControllerUIDDataStaysRepresentable",
        "--- PASS: TestBootstrapLoadIsReadOnlyAndBindsIndependentDigest"
      ],
      "required_stderr": []
    },
    {
      "id": "rust-uid-representation",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-identity-contract",
        "--lib",
        "linux_uid_tests::",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "test result: ok. 1 passed",
        "linux_uid_representation_refuses_only_reserved_sentinel"
      ],
      "required_stderr": []
    },
    {
      "id": "rust-bootstrap-canonical-and-protected-load",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-enrollment-bootstrap",
        "--features",
        "test-fixtures",
        "--test",
        "bootstrap",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "test result: ok. 7 passed"
      ],
      "required_stderr": []
    },
    {
      "id": "rust-control-canonical-and-protected-load",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-enrollment-bootstrap",
        "--features",
        "test-fixtures",
        "--test",
        "control",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "test result: ok. 4 passed"
      ],
      "required_stderr": []
    },
    {
      "id": "rust-authenticated-canonical-and-protected-load",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-enrollment-bootstrap",
        "--features",
        "test-fixtures",
        "--test",
        "authenticated",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "test result: ok. 6 passed"
      ],
      "required_stderr": []
    },
    {
      "id": "rust-pre-entropy-and-output-errors",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-enrollment-authority",
        "--lib",
        "provisioning::tests::",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "test result: ok. 6 passed",
        "provisioning_reserved_service_uid_refuses_before_entropy",
        "provisioning_reserved_controller_uid_refuses_before_entropy"
      ],
      "required_stderr": []
    },
    {
      "id": "rust-materials-cold-lifecycle-and-reopen",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-enrollment-authority",
        "--test",
        "provisioning",
        "--",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "test result: ok. 5 passed",
        "provisioning_material_drives_actual_cold_lifecycle_without_business_key"
      ],
      "required_stderr": []
    },
    {
      "id": "private-uid-contract-rustdoc",
      "command": [
        "cargo",
        "doc",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-identity-contract",
        "-p",
        "swarm-enrollment-bootstrap",
        "-p",
        "swarm-enrollment-authority",
        "--no-deps",
        "--document-private-items"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "Finished"
      ]
    }
  ]
}

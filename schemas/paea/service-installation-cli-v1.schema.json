{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swarm:paea:service-installation-cli:v1",
  "title": "Trusted operator service installation observation; never an authority input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "operation",
    "operation_result",
    "stage",
    "intent",
    "business_journal",
    "personal_journal",
    "publication",
    "startup",
    "human_presence_verified",
    "service_started",
    "confinement_verified"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol": {
      "const": "swarm-service-installation-cli-v1"
    },
    "operation": {
      "enum": [
        "service-install",
        "service-resume",
        "service-reconcile"
      ]
    },
    "operation_result": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "not_attempted",
        "unknown",
        "visible",
        "durable"
      ]
    },
    "intent": {
      "type": "string",
      "enum": [
        "not_attempted",
        "unknown",
        "visible",
        "durable"
      ]
    },
    "business_journal": {
      "type": "string",
      "enum": [
        "not_attempted",
        "unknown",
        "acknowledged",
        "observed"
      ]
    },
    "personal_journal": {
      "type": "string",
      "enum": [
        "not_attempted",
        "unknown",
        "acknowledged",
        "observed"
      ]
    },
    "publication": {
      "type": "string",
      "enum": [
        "not_attempted",
        "unknown",
        "visible",
        "durable"
      ]
    },
    "startup": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bootstrap_path",
            "bootstrap_pin",
            "personal_seed_path"
          ],
          "properties": {
            "bootstrap_path": {
              "type": "string",
              "pattern": "^/"
            },
            "bootstrap_pin": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "personal_seed_path": {
              "type": "string",
              "pattern": "^/"
            }
          }
        }
      ]
    },
    "human_presence_verified": {
      "const": false
    },
    "service_started": {
      "const": false
    },
    "confinement_verified": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation_result": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "publication": {
            "const": "durable"
          },
          "startup": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "startup": {
            "type": "null"
          }
        }
      }
    }
  ]
}

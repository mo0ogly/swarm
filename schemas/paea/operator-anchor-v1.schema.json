{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private operator pin anchor v1 (data only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "request_pin",
    "package_pin"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "protocol": {
      "const": "swarm-operator-anchor-v1"
    },
    "request_pin": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "package_pin": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    }
  }
}

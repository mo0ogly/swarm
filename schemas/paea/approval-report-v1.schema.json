{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swarm:paea:approval-report:v1",
  "title": "PAEA supplied approval correspondence v1",
  "description": "Unsigned data correspondence only; raw input hashes and closed binding field names establish no authenticity, current rights, human attention, approval validity or effect. Native semantic checks additionally require fixed field order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "document",
    "approval_sha256",
    "binding_matches",
    "mismatched_fields",
    "authority",
    "approval_authenticity",
    "approval_validity",
    "effect"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "scope": {
      "const": "offline-data-only"
    },
    "document": {
      "$ref": "#/$defs/identity"
    },
    "approval_sha256": {
      "$ref": "#/$defs/digest"
    },
    "binding_matches": {
      "type": "boolean"
    },
    "mismatched_fields": {
      "type": "array",
      "items": {
        "enum": [
          "action_digest",
          "policy_digest"
        ]
      },
      "uniqueItems": true
    },
    "authority": {
      "const": "not-established"
    },
    "approval_authenticity": {
      "const": "not-established"
    },
    "approval_validity": {
      "const": "not-established"
    },
    "effect": {
      "const": "not-established"
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_sha256",
        "action_digest",
        "intent_id"
      ],
      "properties": {
        "document_sha256": {
          "$ref": "#/$defs/digest"
        },
        "action_digest": {
          "$ref": "#/$defs/digest"
        },
        "intent_id": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "not": {
        "pattern": "[^a-f0-9]"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "binding_matches": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "mismatched_fields": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "mismatched_fields": {
            "minItems": 1
          }
        }
      }
    }
  ]
}

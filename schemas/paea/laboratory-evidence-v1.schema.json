{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swarm:paea:laboratory-evidence:v1",
  "title": "Retained PAEA laboratory evidence; not authenticity or authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "report_sha256",
    "recipe_files",
    "observation_files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope": {
      "const": "retained-laboratory-evidence"
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "recipe_files": {
      "$ref": "#/$defs/files"
    },
    "observation_files": {
      "$ref": "#/$defs/files"
    }
  },
  "$defs": {
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}

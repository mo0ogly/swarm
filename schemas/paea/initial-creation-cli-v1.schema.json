{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dormant initial material completed core result (not transport/current authority)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "operation",
    "core_result",
    "request_pin",
    "package_pin",
    "source_request_read",
    "source_request_durability",
    "intent_publication",
    "anchor_publication",
    "package_publication",
    "intent_read_validation",
    "intent_read_durability",
    "intent_decoded",
    "anchor_read_validation",
    "anchor_read_durability",
    "anchor_decoded",
    "package_read",
    "package_read_durability",
    "material_generation_attempted",
    "material_generation_completed",
    "request_pin_matched",
    "package_request_matched",
    "locator_trust_verified",
    "current_authority_verified",
    "human_authentication_verified",
    "separate_os_uid_verified",
    "confinement_verified",
    "service_installed",
    "service_started"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "protocol": {
      "const": "swarm-initial-creation-cli-v1"
    },
    "operation": {
      "enum": [
        "initial-create",
        "initial-reconcile"
      ]
    },
    "core_result": {
      "const": "completed"
    },
    "request_pin": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "package_pin": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "source_request_read": {
      "const": "decoded"
    },
    "source_request_durability": {
      "const": "directory_acknowledged"
    },
    "intent_publication": {
      "enum": [
        "not_attempted",
        "unknown",
        "visible",
        "durable"
      ]
    },
    "anchor_publication": {
      "enum": [
        "not_attempted",
        "unknown",
        "visible",
        "durable"
      ]
    },
    "package_publication": {
      "enum": [
        "not_attempted",
        "unknown",
        "visible",
        "durable"
      ]
    },
    "intent_read_validation": {
      "enum": [
        "not_attempted",
        "read_unknown",
        "bytes_read",
        "pin_matched"
      ]
    },
    "intent_read_durability": {
      "enum": [
        "not_acknowledged",
        "file_acknowledged",
        "directory_acknowledged"
      ]
    },
    "intent_decoded": {
      "type": "boolean"
    },
    "anchor_read_validation": {
      "enum": [
        "not_attempted",
        "read_unknown",
        "bytes_read",
        "pin_matched"
      ]
    },
    "anchor_read_durability": {
      "enum": [
        "not_acknowledged",
        "file_acknowledged",
        "directory_acknowledged"
      ]
    },
    "anchor_decoded": {
      "type": "boolean"
    },
    "package_read": {
      "enum": [
        "not_attempted",
        "read_unknown",
        "bytes_read",
        "pin_matched",
        "decoded"
      ]
    },
    "package_read_durability": {
      "enum": [
        "not_acknowledged",
        "file_acknowledged",
        "directory_acknowledged"
      ]
    },
    "material_generation_attempted": {
      "type": "boolean"
    },
    "material_generation_completed": {
      "type": "boolean"
    },
    "request_pin_matched": {
      "const": true
    },
    "package_request_matched": {
      "const": true
    },
    "locator_trust_verified": {
      "const": false
    },
    "current_authority_verified": {
      "const": false
    },
    "human_authentication_verified": {
      "const": false
    },
    "separate_os_uid_verified": {
      "const": false
    },
    "confinement_verified": {
      "const": false
    },
    "service_installed": {
      "const": false
    },
    "service_started": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "initial-create"
          }
        }
      },
      "then": {
        "properties": {
          "intent_publication": {
            "const": "durable"
          },
          "anchor_publication": {
            "const": "durable"
          },
          "package_publication": {
            "const": "durable"
          },
          "material_generation_attempted": {
            "const": true
          },
          "material_generation_completed": {
            "const": true
          },
          "package_read": {
            "const": "not_attempted"
          },
          "package_read_durability": {
            "const": "not_acknowledged"
          },
          "intent_read_validation": {
            "const": "not_attempted"
          },
          "intent_read_durability": {
            "const": "not_acknowledged"
          },
          "intent_decoded": {
            "const": false
          },
          "anchor_read_validation": {
            "const": "not_attempted"
          },
          "anchor_read_durability": {
            "const": "not_acknowledged"
          },
          "anchor_decoded": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "intent_publication": {
            "const": "not_attempted"
          },
          "anchor_publication": {
            "const": "not_attempted"
          },
          "package_publication": {
            "const": "not_attempted"
          },
          "material_generation_attempted": {
            "const": false
          },
          "material_generation_completed": {
            "const": false
          },
          "package_read": {
            "const": "decoded"
          },
          "package_read_durability": {
            "const": "directory_acknowledged"
          },
          "intent_read_validation": {
            "const": "bytes_read"
          },
          "intent_read_durability": {
            "const": "directory_acknowledged"
          },
          "intent_decoded": {
            "const": true
          },
          "anchor_read_validation": {
            "const": "bytes_read"
          },
          "anchor_read_durability": {
            "const": "directory_acknowledged"
          },
          "anchor_decoded": {
            "const": true
          }
        }
      }
    }
  ]
}

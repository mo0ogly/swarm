{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable pre-generation intent, data only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "request_pin"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "protocol": {
      "const": "swarm-initial-provisioning-intent-v1"
    },
    "request_pin": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    }
  }
}

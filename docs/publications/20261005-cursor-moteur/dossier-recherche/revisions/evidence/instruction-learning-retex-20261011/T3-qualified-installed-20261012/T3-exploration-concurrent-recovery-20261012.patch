+package engine
+
+import (
+	"encoding/json"
+	"fmt"
+	"path"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// Exploration reads an immutable accepted Git tree. It executes no user command,
+// changes no source and grants no production, integration or acceptance right.
+type PlanningExplorationRequest struct {
+	Mode      string   `json:"mode"`
+	Candidate string   `json:"candidate_commit"`
+	Directory string   `json:"directory,omitempty"`
+	Files     []string `json:"files,omitempty"`
+}
+type PlanningExploration struct {
+	Scope         string                     `json:"scope"`
+	ScopeRevision int                        `json:"scope_revision"`
+	Generation    int                        `json:"generation"`
+	Revision      int                        `json:"observed_revision"`
+	Decision      string                     `json:"request_decision"`
+	Candidate     string                     `json:"candidate_commit"`
+	Request       PlanningExplorationRequest `json:"request"`
+	Entries       []string                   `json:"entries,omitempty"`
+	Sources       []ReviewSource             `json:"sources,omitempty"`
+	Digest        string                     `json:"sha256"`
+}
+
+func validExplorationDirectory(directory string) bool {
+	return directory == "" || (path.Clean(directory) == directory && directory != "." && !path.IsAbs(directory) && !strings.HasPrefix(directory, "../") && !strings.ContainsAny(directory, "\x00\r\n\\:") && directory != ".git" && !strings.HasPrefix(directory, ".git/") && directory != ".swarm" && !strings.HasPrefix(directory, ".swarm/"))
+}
+func explorationDigest(e PlanningExploration) string {
+	e.Digest = ""
+	raw, _ := json.Marshal(e)
+	return hash(raw)
+}
+func explorationCurrent(w Work, e *PlanningExploration) bool {
+	return e == nil || (w.Planning != nil && w.Planning.Repository != nil && e.Candidate == w.Planning.Repository.Candidate && e.Digest == explorationDigest(*e))
+}
+func (s *Store) preparePlanningExploration(w Work, r PlanningRequest, op PlanningOperation) (*PlanningExploration, error) {
+	if w.Planning == nil || w.Planning.Repository == nil {
+		return nil, fmt.Errorf("exploration en lecture exige un dépôt géré accepté")
+	}
+	scope, err := w.Planning.scope(r.Scope)
+	if err != nil {
+		return nil, err
+	}
+	until, parseErr := time.Parse(time.RFC3339Nano, scope.Until)
+	if w.Planning.Paused || s.paused(w.ID) || scope.Holder == "" || scope.Holder != r.Holder || scope.Generation != r.Generation || scope.Revision != r.ScopeRevision || parseErr != nil || !time.Now().Before(until) {
+		return nil, planningError("stale_lease", "autorisation d’exploration absente ou périmée")
+	}
+	if op.ID == "" || !safeName(op.ID) || op.Title != "" || len(op.Requirements) != 0 || len(op.Criteria) != 0 || len(op.Depends) != 0 || op.Next != "" || op.MaxTasks != 0 || op.MaxActivations != 0 {
+		return nil, fmt.Errorf("explore accepte uniquement id et deliverable JSON")
+	}
+	var query PlanningExplorationRequest
+	if err = strict([]byte(op.Deliverable), &query); err != nil {
+		return nil, err
+	}
+	if query.Candidate == "" || query.Candidate != w.Planning.Repository.Candidate {
+		return nil, fmt.Errorf("candidat d’exploration remplacé ; relire le contexte")
+	}
+	_, method, err := s.projectAgentWorkflow(planningWorkflowRole(scope))
+	if err != nil {
+		return nil, err
+	}
+	// Reuse the existing technical wire envelope, after the actual role method
+	// and instruction overhead. No independent hard-coded exploration policy.
+	capacity := planningPromptContextLimit(method)
+	e := &PlanningExploration{Scope: r.Scope, ScopeRevision: r.ScopeRevision, Generation: r.Generation, Revision: w.Revision, Decision: r.EventID, Candidate: query.Candidate, Request: query}
+	bare := filepath.Join(w.Planning.Repository.Storage, "repository.git")
+	switch query.Mode {
+	case "read":
+		if query.Directory != "" || len(query.Files) == 0 {
+			return nil, fmt.Errorf("read exige files non vide, sans directory")
+		}
+		seen := map[string]bool{}
+		for _, name := range query.Files {
+			if seen[name] || name == ".swarm" || strings.HasPrefix(name, ".swarm/") {
+				return nil, fmt.Errorf("source répétée ou privée")
+			}
+			seen[name] = true
+			source, readErr := candidateReviewSource(bare, query.Candidate, name, capacity)
+			if readErr != nil {
+				return nil, readErr
+			}
+			e.Sources = append(e.Sources, source)
+			raw, _ := json.Marshal(e)
+			if len(raw) > capacity {
+				return nil, fmt.Errorf("exploration supérieure au transport du rôle (%d octets) ; réduire la requête, aucun contenu tronqué", capacity)
+			}
+		}
+	case "list":
+		if len(query.Files) != 0 || !validExplorationDirectory(query.Directory) {
+			return nil, fmt.Errorf("list exige un directory relatif, sans files")
+		}
+		tree := query.Candidate
+		if query.Directory != "" {
+			tree, err = managedGit(bare, "rev-parse", query.Candidate+":"+query.Directory)
+			if err != nil {
+				return nil, err
+			}
+			kind, kindErr := managedGit(bare, "cat-file", "-t", tree)
+			if kindErr != nil || kind != "tree" {
+				return nil, fmt.Errorf("répertoire Git régulier requis")
+			}
+		}
+		names, listErr := scopeGit(bare, "ls-tree", "--name-only", "-z", tree)
+		if listErr != nil {
+			return nil, listErr
+		}
+		if names != "" {
+			for _, name := range strings.Split(strings.TrimSuffix(names, "\x00"), "\x00") {
+				if name == ".git" || name == ".swarm" {
+					continue
+				}
+				e.Entries = append(e.Entries, path.Join(query.Directory, name))
+			}
+		}
+	default:
+		return nil, fmt.Errorf("mode d’exploration requis : list ou read")
+	}
+	e.Digest = explorationDigest(*e)
+	raw, _ := json.Marshal(e)
+	if len(raw) > capacity {
+		return nil, fmt.Errorf("inventaire supérieur au transport du rôle ; préciser le répertoire, aucun contenu tronqué")
+	}
+	return e, nil
+}
+func (s *Store) checkPlanningExplorationDelivery(w Work, r PlanningRequest) error {
+	if len(r.explorationInputs) == 0 {
+		return nil
+	}
+	raw, _ := json.Marshal(w)
+	var projected Work
+	if err := json.Unmarshal(raw, &projected); err != nil {
+		return err
+	}
+	for i := range projected.Planning.Inbox {
+		if containsString(r.Inputs, projected.Planning.Inbox[i].ID) {
+			projected.Planning.Inbox[i].Decision = r.EventID
+		}
+	}
+	for _, op := range r.Operations {
+		if e := r.explorationInputs[op.ID]; op.Kind == "explore" && e != nil {
+			projected.Planning.Inbox = append(projected.Planning.Inbox, PlanningEvent{ID: planningEventID(r.EventID, op.ID), Scope: r.Scope, Kind: "exploration", Message: "Exploration en lecture du candidat accepté ; originaux et attribution joints.", Exploration: e, At: now()})
+		}
+	}
+	scope, err := projected.Planning.scope(r.Scope)
+	if err != nil {
+		return err
+	}
+	scope.Revision++
+	scope.Generation++
+	scope.Holder = ""
+	scope.Until = ""
+	scope.State = "ready"
+	projected.Revision++
+	_, method, err := s.projectAgentWorkflow(planningWorkflowRole(scope))
+	if err != nil {
+		return err
+	}
+	for _, e := range r.explorationInputs {
+		// Every original must fit a whole single-event activation; admission may
+		// batch fewer complete events, but must never truncate source bytes.
+		oneRaw, _ := json.Marshal(projected)
+		var one Work
+		if err = json.Unmarshal(oneRaw, &one); err != nil {
+			return err
+		}
+		filtered := []PlanningEvent{}
+		for _, event := range one.Planning.Inbox {
+			if event.Scope != r.Scope || event.Decision != "" {
+				filtered = append(filtered, event)
+			} else if event.Exploration != nil && event.Exploration.Digest == e.Digest {
+				filtered = append(filtered, event)
+			}
+		}
+		one.Planning.Inbox = filtered
+		if _, _, err = s.planningDeliveryContext(one, r.Scope, planningPromptContextLimit(method)); err != nil {
+			return fmt.Errorf("original d’exploration non transmissible au propriétaire : %w", err)
+		}
+	}
+	return nil
+}
+func applyPlanningExploration(w *Work, scope string, op PlanningOperation, r PlanningRequest) error {
+	e := r.explorationInputs[op.ID]
+	if e == nil || e.Scope != scope || e.ScopeRevision != r.ScopeRevision || e.Generation != r.Generation || e.Revision != w.Revision || e.Decision != r.EventID || !explorationCurrent(*w, e) {
+		return fmt.Errorf("preuve d’exploration absente ou périmée")
+	}
+	w.Planning.Inbox = append(w.Planning.Inbox, PlanningEvent{ID: planningEventID(r.EventID, op.ID), Scope: scope, Kind: "exploration", Message: "Exploration en lecture du candidat accepté ; originaux et attribution joints.", Exploration: e, At: now()})
+	return nil
+}
+
+func planningExplorationRepository(w Work) any {
+	if w.Planning == nil || w.Planning.Repository == nil {
+		return nil
+	}
+	return map[string]any{"candidate_commit": w.Planning.Repository.Candidate, "modes": []string{"list", "read"}, "read_only": true, "source": "immutable accepted Git tree", "capacity": "actual role transport envelope; complete sources or explicit refusal"}
+}
diff --git a/internal/engine/planning_judge.go b/internal/engine/planning_judge.go
new file mode 100644
index 0000000..8984ca7
--- /dev/null
+++ b/internal/engine/planning_judge.go
@@ -0,0 +1,143 @@
+package engine
+
+import (
+	"fmt"
+	"time"
+)
+
+// JudgeState is the mission-wide continue/end verdict (JAN-4). It is kept
+// distinct from the independent per-candidate review (V1-V5, see
+// independent_review.go): the judge decides on the mission objective and the
+// cumulated cycle results, never on a single candidate diff. It lives inside
+// the same Work/PlanningState body as every other planning field (root
+// scope only), so it shares the same revision, event log and optimistic
+// concurrency boundary -- no second persistence path, no second acceptance
+// schema.
+type JudgeState struct {
+	Verdict     string             `json:"verdict,omitempty"`
+	Reason      string             `json:"reason,omitempty"`
+	EvidenceRef string             `json:"evidence_ref,omitempty"`
+	At          string             `json:"at,omitempty"`
+	Cycle       int                `json:"cycle"`
+	MaxCycles   int                `json:"max_cycles"`
+	Closed      bool               `json:"closed"`
+	History     []JudgeCycleRecord `json:"history,omitempty"`
+}
+
+// JudgeCycleRecord is one past, immutable cycle verdict (JAN-5/FEB-3): a
+// renewal never rewrites it, so the mission keeps every prior decision even
+// as the live JudgeState moves on to a fresh cycle.
+type JudgeCycleRecord struct {
+	Verdict     string `json:"verdict"`
+	Reason      string `json:"reason"`
+	EvidenceRef string `json:"evidence_ref,omitempty"`
+	At          string `json:"at"`
+	RenewedAt   string `json:"renewed_at,omitempty"`
+	Cycle       int    `json:"cycle"`
+}
+
+// Policy bounds for max_judge_cycles at "enable" time. Like MaxActivations/
+// MaxTasks/MaxDecisions on the same request, this is a caller-supplied,
+// persisted-in-the-work value (see "enable" in applyPlanning), not a fixed
+// policy baked into Go: only the *fallback-when-unset* default is a literal,
+// exactly like RunLimits.normalized()'s own defaults.
+const (
+	defaultMaxJudgeCycles = 20
+	maxJudgeCyclesBound   = 500
+)
+
+// applyJudgeVerdict implements the JAN-4 global judge: a verdict ("continue"
+// or "end") on the current cycle, distinct from and never overriding the
+// independent candidate review (it never touches w.Planning.Repository,
+// Reviewer or any V1-V5 field). A verdict can be rendered only once per
+// cycle (judge_already_decided); renew (applyJudgeRenewal) must run before a
+// new one. An "end" verdict is refused without an attested candidate
+// matching the engine's own current managed-repository candidate (req-8:
+// no global closure without fresh evidence) -- the same mismatch that
+// invalidated an earlier, unrelated attempt at this task is refused here
+// structurally rather than caught later by review.
+func (s *Store) applyJudgeVerdict(w *Work, r PlanningRequest, at time.Time) error {
+	p := w.Planning
+	if p.Failure != "" {
+		return fmt.Errorf("planification arrêtée : %s", p.Failure)
+	}
+	if p.Judge == nil || p.Judge.Closed {
+		return planningError("judge_closed", "juge global clos ou non initialisé : activation ou reprise requise")
+	}
+	if r.JudgeCycle != p.Judge.Cycle {
+		return planningError("stale_verdict", "verdict périmé : le cycle de juge a changé depuis la lecture")
+	}
+	if p.Judge.Verdict != "" {
+		return planningError("judge_already_decided", "ce cycle a déjà reçu un verdict ; renouveler avant de rejuger")
+	}
+	if r.JudgeVerdict != "continue" && r.JudgeVerdict != "end" {
+		return fmt.Errorf("judge_verdict doit valoir continue ou end")
+	}
+	if !nonempty(r.Reason) || len(r.Reason) > 4000 {
+		return fmt.Errorf("motif du verdict requis, 4000 caractères maximum")
+	}
+	if r.JudgeVerdict == "end" {
+		if !nonempty(r.ExpectedCandidate) {
+			return planningError("stale_evidence", "clôture refusée : candidat attesté requis (preuve fraîche)")
+		}
+		if p.Repository == nil || p.Repository.Candidate != r.ExpectedCandidate {
+			return planningError("stale_evidence", "clôture refusée : candidat attesté distinct du candidat courant du dépôt géré")
+		}
+		if err := s.validatePlanningClosure(w, "root", r); err != nil {
+			return planningError("stale_evidence", "clôture refusée : "+err.Error())
+		}
+	}
+	p.Judge.Verdict = r.JudgeVerdict
+	p.Judge.Reason = r.Reason
+	p.Judge.EvidenceRef = r.ExpectedCandidate
+	p.Judge.At = at.Format(time.RFC3339Nano)
+	if r.JudgeVerdict == "end" {
+		p.Judge.Closed = true
+	}
+	p.Judge.History = append(p.Judge.History, JudgeCycleRecord{Cycle: p.Judge.Cycle, Verdict: p.Judge.Verdict, Reason: p.Judge.Reason, EvidenceRef: p.Judge.EvidenceRef, At: p.Judge.At})
+	return nil
+}
+
+// applyJudgeRenewal implements the JAN-5/FEB-3 cycle renewal: it opens a
+// fresh cycle (new context for the next judge verdict) while preserving the
+// scope objective/requirements, every activation/decision counter and the
+// full judge History -- a renewal, never a reset. Only a "continue" verdict
+// can be renewed; an "end" verdict stays Closed permanently (no implicit
+// reopening). Each renewal consumes one unit of the max_judge_cycles quota
+// fixed at enable time; exhausting it refuses further renewal until an
+// operator raises it through a new "enable" (a quota ceiling is never
+// raised implicitly by this action).
+func applyJudgeRenewal(w *Work, r PlanningRequest, at time.Time) error {
+	p := w.Planning
+	if p.Failure != "" {
+		return fmt.Errorf("planification arrêtée : %s", p.Failure)
+	}
+	if p.Judge == nil || p.Judge.Closed {
+		return planningError("judge_closed", "juge global clos ou non initialisé : aucun renouvellement possible")
+	}
+	if r.JudgeCycle != p.Judge.Cycle {
+		return planningError("stale_verdict", "verdict périmé : le cycle a déjà été renouvelé")
+	}
+	if p.Judge.Verdict == "" {
+		return fmt.Errorf("renouvellement refusé : aucun verdict à renouveler, juger d'abord ce cycle")
+	}
+	if p.Judge.Verdict != "continue" {
+		return fmt.Errorf("renouvellement refusé : le dernier verdict n'est pas continue")
+	}
+	if p.Judge.Cycle >= p.Judge.MaxCycles {
+		return planningError("quota_exceeded", "quota de cycles de juge atteint")
+	}
+	renewedAt := at.Format(time.RFC3339Nano)
+	if n := len(p.Judge.History); n > 0 && p.Judge.History[n-1].Cycle == p.Judge.Cycle {
+		p.Judge.History[n-1].RenewedAt = renewedAt
+	}
+	// Fresh context for the next cycle: only the live verdict/reason/evidence
+	// reset. Objective, requirements, activation/decision counters and every
+	// past cycle in History are never touched.
+	p.Judge.Cycle++
+	p.Judge.Verdict = ""
+	p.Judge.Reason = ""
+	p.Judge.EvidenceRef = ""
+	p.Judge.At = ""
+	return nil
+}
diff --git a/internal/engine/planning_judge_test.go b/internal/engine/planning_judge_test.go
new file mode 100644
index 0000000..bc1a601
--- /dev/null
+++ b/internal/engine/planning_judge_test.go
@@ -0,0 +1,314 @@
+//go:build linux
+
+package engine
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// The adopted plan names this checkpoint control. Exercise its real managed
+// cycle and public CLI instead of allowing an empty regexp match to look green.
+func TestManagedCheckpointRecovery(t *testing.T) {
+	s, w := managedFixture(t)
+	before := w.Planning
+	owner, _ := before.scope("root")
+	request := PlanningRequest{Schema: 1, EventID: "checkpoint-judge", Revision: w.Revision, Scope: "root", ScopeRevision: owner.Revision, JudgeCycle: 1, JudgeVerdict: "continue", Reason: "Conserver les preuves avant le renouvellement"}
+	input := filepath.Join(t.TempDir(), "request.json")
+	write := func(r PlanningRequest) {
+		t.Helper()
+		b, _ := json.Marshal(r)
+		if err := os.WriteFile(input, b, 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write(request)
+	var output bytes.Buffer
+	if err := s.planningCLI([]string{"planning", "judge", w.ID}, input, &output); err != nil {
+		t.Fatal(err)
+	}
+	reopened, err := openStore(s.root, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reopened.db.Close()
+	current, _ := reopened.get(w.ID)
+	owner, _ = current.Planning.scope("root")
+	request = PlanningRequest{Schema: 1, EventID: "checkpoint-renew", Revision: current.Revision, Scope: "root", ScopeRevision: owner.Revision, JudgeCycle: 1}
+	write(request)
+	if err = reopened.planningCLI([]string{"planning", "renew", w.ID}, input, &output); err != nil {
+		t.Fatal(err)
+	}
+	after, _ := reopened.get(w.ID)
+	if after.Planning.Judge.Cycle != 2 || after.Planning.Judge.Verdict != "" || len(after.Planning.Judge.History) != 1 || after.Planning.Repository.Candidate != before.Repository.Candidate || after.Planning.Activations != before.Activations || after.Planning.Decisions != before.Decisions || len(after.Tasks) != len(w.Tasks) || managedReviewCalls(t, reopened) != 0 {
+		t.Fatal("checkpoint recovery changed candidate, history, tasks or accounting")
+	}
+	if err = reopened.planningCLI([]string{"planning", "renew", w.ID}, input, &output); err != nil {
+		t.Fatal(err)
+	}
+	replay, _ := reopened.get(w.ID)
+	if replay.Revision != after.Revision || replay.Planning.Judge.Cycle != 2 || managedReviewCalls(t, reopened) != 0 {
+		t.Fatal("checkpoint replay caused another effect or review")
+	}
+}
+
+func judgeDo(t *testing.T, s *Store, w Work, action string, cycle int, extra PlanningRequest) (Work, error) {
+	t.Helper()
+	owner, e := w.Planning.scope("root")
+	if e != nil {
+		t.Fatal(e)
+	}
+	extra.Schema = 1
+	extra.EventID = newID("test-judge-")
+	extra.Revision = w.Revision
+	extra.Scope = "root"
+	extra.ScopeRevision = owner.Revision
+	extra.JudgeCycle = cycle
+	return s.planningChange(w.ID, action, extra)
+}
+
+func TestPlanningJudgeEndRejectsMatchingCandidateWithoutProofs(t *testing.T) {
+	s, w := planningFixture(t)
+	w.Planning.Repository = &ManagedRepository{Source: "fixture", Candidate: "candidate-without-proofs"}
+	raw, _ := json.Marshal(w)
+	if _, err := s.db.Exec("UPDATE works SET body=? WHERE id=?", raw, w.ID); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := judgeDo(t, s, w, "judge", 1, PlanningRequest{JudgeVerdict: "end", Reason: "Le candidat seul ne prouve pas les exigences", ExpectedCandidate: "candidate-without-proofs"}); err == nil {
+		t.Fatal("matching candidate allowed global closure without requirement evidence")
+	}
+	got, _ := s.get(w.ID)
+	if got.Revision != w.Revision || got.Planning.Judge.Closed || len(got.Planning.Judge.History) != 0 {
+		t.Fatal("rejected closure changed revision, verdict or history")
+	}
+}
+
+// req-5: the global judge renders a verdict distinct from -- and never
+// mutating -- the independent per-candidate review fields.
+func TestPlanningJudgeVerdictDistinctFromCandidateReview(t *testing.T) {
+	s, w := planningFixture(t)
+	if w.Planning.Judge == nil || w.Planning.Judge.Cycle != 1 || w.Planning.Judge.MaxCycles != defaultMaxJudgeCycles {
+		t.Fatalf("juge non initialisé à l'activation : %+v", w.Planning.Judge)
+	}
+	got, err := judgeDo(t, s, w, "judge", 1, PlanningRequest{JudgeVerdict: "continue", Reason: "objectif en cours, aucun blocage"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.Planning.Judge.Verdict != "continue" || len(got.Planning.Judge.History) != 1 || got.Planning.Judge.History[0].Cycle != 1 {
+		t.Fatalf("verdict non enregistré : %+v", got.Planning.Judge)
+	}
+	if got.Planning.Judge.Closed {
+		t.Fatal("continue ne doit jamais clore la mission")
+	}
+	// Distinctness: the verdict never touches the candidate-review surface.
+	if got.Planning.Repository != nil || got.Planning.ReviewerRequired || got.Planning.Reviewer != nil {
+		t.Fatal("le juge global a modifié un champ de la revue indépendante de candidat")
+	}
+}
+
+// req-8: no global closure ("end") without an attested candidate matching
+// the engine's own current managed-repository candidate.
+func judgeAcceptedFixture(t *testing.T) (*Store, Work) {
+	t.Helper()
+	s, w := managedFixture(t)
+	for _, id := range []string{"first", "second"} {
+		a := managedCompleted(t, s, w, id, "Accepted "+id+"\n")
+		if err := s.finishAgent(a, "completed", "", nil); err != nil {
+			t.Fatal(err)
+		}
+		a, _ = s.agent(a.ID)
+		if err := s.integrateManagedAttempt(a); err != nil {
+			t.Fatal(err)
+		}
+		w, _ = s.get(w.ID)
+	}
+	for i := range w.Tasks {
+		if !s.acceptedFresh(&w, &w.Tasks[i], map[string]bool{}) {
+			t.Fatal("fixture lacks fresh acceptance")
+		}
+	}
+	return s, w
+}
+
+func TestPlanningJudgeEndRequiresFreshMatchingCandidate(t *testing.T) {
+	s, w := judgeAcceptedFixture(t)
+	for _, candidate := range []string{"", "candidate-different"} {
+		if _, err := judgeDo(t, s, w, "judge", 1, PlanningRequest{JudgeVerdict: "end", Reason: "Toutes les preuves sont examinées", ExpectedCandidate: candidate}); err == nil {
+			t.Fatal("absent or different candidate accepted")
+		}
+	}
+	got, err := judgeDo(t, s, w, "judge", 1, PlanningRequest{JudgeVerdict: "end", Reason: "Toutes les tâches sont acceptées avec preuves fraîches", ExpectedCandidate: w.Planning.Repository.Candidate})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !got.Planning.Judge.Closed || got.Planning.Judge.EvidenceRef != w.Planning.Repository.Candidate || got.Planning.Scopes[0].State != w.Planning.Scopes[0].State {
+		t.Fatal("judge verdict replaced scope conduct or omitted evidence")
+	}
+	if _, err = judgeDo(t, s, got, "judge", 1, PlanningRequest{JudgeVerdict: "continue", Reason: "Reprise"}); err == nil {
+		t.Fatal("closed judge reopened")
+	}
+	if _, err = judgeDo(t, s, got, "renew", 1, PlanningRequest{}); err == nil {
+		t.Fatal("closed judge renewed")
+	}
+}
+
+func TestPlanningJudgeEndRejectsStaleReviewAndActiveProcess(t *testing.T) {
+	for _, kind := range []string{"review", "control", "active"} {
+		t.Run(kind, func(t *testing.T) {
+			s, w := judgeAcceptedFixture(t)
+			switch kind {
+			case "review":
+				w.Tasks[0].IndependentReview.State = "changes_requested"
+			case "control":
+				if err := os.WriteFile(filepath.Join(s.root, w.Tasks[0].AutoValidation.Receipt), []byte("altered control receipt"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			case "active":
+				a := Agent{ID: "active-end-fixture", WorkID: w.ID, TaskID: "first", Role: "worker", Status: "running"}
+				body, _ := json.Marshal(a)
+				if _, err := s.db.Exec("INSERT INTO agents(id,work_id,task_id,cwd,status,desired,body,request) VALUES(?,?,?,'','running','',?,?)", a.ID, w.ID, a.TaskID, body, []byte(`{}`)); err != nil {
+					t.Fatal(err)
+				}
+			}
+			body, _ := json.Marshal(w)
+			if _, err := s.db.Exec("UPDATE works SET body=? WHERE id=?", body, w.ID); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := judgeDo(t, s, w, "judge", 1, PlanningRequest{JudgeVerdict: "end", Reason: "Même identité ne remplace pas les preuves", ExpectedCandidate: w.Planning.Repository.Candidate}); err == nil {
+				t.Fatal("invalid end accepted", kind)
+			}
+			got, _ := s.get(w.ID)
+			if got.Revision != w.Revision || got.Planning.Judge.Closed || len(got.Planning.Judge.History) != 0 {
+				t.Fatal("rejected end mutated judge")
+			}
+		})
+	}
+}
+
+// req-6: renewal opens a fresh cycle (new context for the next verdict)
+// while preserving objective, requirements, counters and judge history.
+func TestPlanningJudgeRenewalPreservesContextAndHistory(t *testing.T) {
+	s, w := planningFixture(t)
+	w, err := judgeDo(t, s, w, "judge", 1, PlanningRequest{JudgeVerdict: "continue", Reason: "en cours"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	objectiveBefore, requirementsBefore := w.Planning.Scopes[0].Objective, w.Planning.Scopes[0].Requirements
+	maxActivationsBefore, maxTasksBefore := w.Planning.MaxActivations, w.Planning.MaxTasks
+	got, err := judgeDo(t, s, w, "renew", 1, PlanningRequest{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	j := got.Planning.Judge
+	if j.Cycle != 2 || j.Verdict != "" || j.Reason != "" || j.EvidenceRef != "" {
+		t.Fatalf("cycle non renouvelé proprement : %+v", j)
+	}
+	if len(j.History) != 1 || j.History[0].Cycle != 1 || j.History[0].Verdict != "continue" || j.History[0].RenewedAt == "" {
+		t.Fatalf("historique du cycle précédent perdu ou non marqué renouvelé : %+v", j.History)
+	}
+	if got.Planning.Scopes[0].Objective != objectiveBefore || len(got.Planning.Scopes[0].Requirements) != len(requirementsBefore) {
+		t.Fatal("objectif ou exigences perdus par le renouvellement")
+	}
+	if got.Planning.MaxActivations != maxActivationsBefore || got.Planning.MaxTasks != maxTasksBefore {
+		t.Fatal("limites de la mission modifiées par un simple renouvellement de cycle")
+	}
+	reopened, err := openStore(s.root, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reopened.db.Close()
+	persisted, err := reopened.get(got.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	context, err := planningContext(persisted, "root")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var projection struct {
+		Cycle struct {
+			Cycle   int    `json:"cycle"`
+			Verdict string `json:"verdict"`
+			History int    `json:"history_records"`
+		} `json:"global_cycle"`
+	}
+	if err = json.Unmarshal(context, &projection); err != nil || projection.Cycle.Cycle != 2 || projection.Cycle.Verdict != "" || projection.Cycle.History != 1 {
+		t.Fatal("renewed context missing after reopening", err, string(context))
+	}
+	// A second verdict can now be rendered on the fresh cycle.
+	got, err = judgeDo(t, s, got, "judge", 2, PlanningRequest{JudgeVerdict: "continue", Reason: "toujours en cours"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got.Planning.Judge.History) != 2 {
+		t.Fatalf("deuxième cycle non consigné : %+v", got.Planning.Judge.History)
+	}
+}
+
+// req-7: replay (same event_id), a stale cycle number and a double verdict
+// on the same cycle must all refuse the effect -- no double application.
+func TestPlanningJudgeReplayStaleAndDoubleVerdictRefused(t *testing.T) {
+	s, w := planningFixture(t)
+	owner, _ := w.Planning.scope("root")
+	request := PlanningRequest{Schema: 1, EventID: "fixed-judge-event", Revision: w.Revision, Scope: "root", ScopeRevision: owner.Revision, JudgeCycle: 1, JudgeVerdict: "continue", Reason: "premier verdict"}
+	first, err := s.planningChange(w.ID, "judge", request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Exact replay (same event_id, same content): idempotent, no new effect.
+	replay, err := s.planningChange(w.ID, "judge", request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if replay.Revision != first.Revision || len(replay.Planning.Judge.History) != 1 {
+		t.Fatalf("rejeu a produit un second effet : %+v", replay.Planning.Judge)
+	}
+	// Double verdict on the same cycle, different event: refused.
+	if _, err = judgeDo(t, s, first, "judge", 1, PlanningRequest{JudgeVerdict: "end", Reason: "second verdict", ExpectedCandidate: "x"}); err == nil {
+		t.Fatal("second verdict sur le même cycle accepté")
+	}
+	renewed, err := judgeDo(t, s, first, "renew", 1, PlanningRequest{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Stale cycle: still claiming cycle 1 after renewal moved to cycle 2.
+	if _, err = judgeDo(t, s, renewed, "judge", 1, PlanningRequest{JudgeVerdict: "continue", Reason: "verdict périmé"}); err == nil {
+		t.Fatal("verdict basé sur un cycle périmé accepté")
+	}
+	// Renewal cannot be requested twice for the same (now stale) cycle either.
+	if _, err = judgeDo(t, s, renewed, "renew", 1, PlanningRequest{}); err == nil {
+		t.Fatal("renouvellement basé sur un cycle périmé accepté")
+	}
+}
+
+// req-7 (quota/limite): a mission paused refuses judge/renew effects, and
+// exhausting the max_judge_cycles quota refuses further renewal.
+func TestPlanningJudgePausedAndQuotaRefuseEffects(t *testing.T) {
+	s := storeTest(t)
+	w := createTest(t, s)
+	w = planningDo(t, s, w, "enable", PlanningRequest{MaxTasks: 10, MaxDecisions: 10, MaxActivations: 15, MaxJudgeCycles: 1})
+	if w.Planning.Judge.MaxCycles != 1 {
+		t.Fatalf("quota configuré non respecté : %+v", w.Planning.Judge)
+	}
+	w, err := judgeDo(t, s, w, "judge", 1, PlanningRequest{JudgeVerdict: "continue", Reason: "en cours"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = judgeDo(t, s, w, "renew", 1, PlanningRequest{}); err == nil {
+		t.Fatal("renouvellement accepté au-delà du quota de cycles")
+	}
+	// Pause the mission, then confirm a fresh judge call on the still-live
+	// cycle is refused while paused.
+	w = planningDo(t, s, w, "pause", PlanningRequest{})
+	if !w.Planning.Paused {
+		t.Fatal("mission non marquée en pause")
+	}
+	owner, _ := w.Planning.scope("root")
+	_, err = s.planningChange(w.ID, "renew", PlanningRequest{Schema: 1, EventID: newID("test-judge-"), Revision: w.Revision, Scope: "root", ScopeRevision: owner.Revision, JudgeCycle: w.Planning.Judge.Cycle})
+	if err == nil {
+		t.Fatal("renouvellement accepté sur une mission en pause")
+	}
+}

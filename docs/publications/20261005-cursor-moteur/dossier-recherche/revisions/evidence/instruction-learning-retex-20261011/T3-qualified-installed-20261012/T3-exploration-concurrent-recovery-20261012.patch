+func TestCursorEngineT3FutureDependencyAdaptationPreservesBlockedResult(t *testing.T) {
+	s, w := managedFixture(t)
+	w, err := s.mutate(w.ID, "test.prerequisite", "blocked-fixture", w.Revision, []byte(`{}`), func(current *Work) error {

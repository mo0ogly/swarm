+	mux := http.NewServeMux()
+	s.registerPlanning(mux, func(out http.ResponseWriter, v any) { json.NewEncoder(out).Encode(v) }, func(out http.ResponseWriter, e error) { http.Error(out, e.Error(), 400) })
+	body, _ := json.Marshal(r)

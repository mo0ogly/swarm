+        M_BOUNDARY["Frontière durable du dialogue<br/>Tour · session · usage · confirmation"]
+        M_RECOVERY["Diagnostic de reprise en lecture seule<br/>checkpoint_sha256 · facts_sha256"]
+        M_RECONCILE["Effets incertains à réconcilier<br/>Pas de rejeu implicite"]

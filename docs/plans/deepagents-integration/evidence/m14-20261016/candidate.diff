+		}
+		g, err := c.restoreGuard(previous, s.root)
+		if err != nil {
+			return nil, err
+		}
+		m.sink.guard = g
+		m.session = c.Session
+		m.usage = cloneDialogueUsage(c.Usage)
+		m.baseProgress = base
+		m.sink.reportedModel = c.Model
+	}
+	return m, nil
+}

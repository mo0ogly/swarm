+				t.Fatalf("activity rows unaccounted for: %+v / %d operations", p, len(operations))
+			}
+			if scenario == "filtered" && (p.Excluded != 1 || p.Duplicate != 2 || len(operations) != 2) {
+				t.Fatalf("filters not attributed: %+v", p)

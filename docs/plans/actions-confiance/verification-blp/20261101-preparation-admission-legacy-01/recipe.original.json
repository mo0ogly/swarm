{
  "schema_version": 1,
  "id": "blp-preparation-admission-legacy-replay",
  "inputs": [
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    "rust/crates/*/Cargo.toml",
    "rust/crates/swarm-engine/config/**/*",
    "rust/crates/swarm-engine/tests/confidentiality.rs",
    "tools/verification/recipe.py",
    "rust/crates/swarm-engine/tests/trust_enrollment.rs",
    "rust/crates/swarm-enrollment-authority/tests/common/**/*",
    "rust/crates/swarm-biba-linux/src/**/*",
    "rust/crates/swarm-confidentiality/src/**/*",
    "rust/crates/swarm-engine/src/**/*",
    "rust/crates/swarm-enrollment-authority/src/**/*",
    "rust/crates/swarm-enrollment-bootstrap/src/**/*",
    "rust/crates/swarm-enrollment-config/src/**/*",
    "rust/crates/swarm-enrollment-proof/src/**/*",
    "rust/crates/swarm-enrollment-state/src/**/*",
    "rust/crates/swarm-identity-contract/src/**/*",
    "rust/crates/swarm-linux-identity-channel/src/**/*",
    "rust/crates/swarm-linux-prerequisites/src/**/*",
    "rust/crates/swarm-protection-contract/src/**/*",
    "rust/crates/swarm-wire-json/src/**/*",
    "rust/crates/swarm-engine/examples/preparation_quarantine_fixture.rs",
    "rust/crates/swarm-engine/src/root_store/preparation_confidentiality_tests.rs",
    "rust/crates/swarm-engine/tests/preparation_calls.rs"
  ],
  "environment": {
    "CARGO_TARGET_DIR": "{root}/.cache/blp-verification-target",
    "CARGO_INCREMENTAL": "0",
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_BUILD_JOBS": "1"
  },
  "steps": [
    {
      "id": "historical-replay-keeps-no-native-custody",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--test",
        "preparation_calls",
        "legacy_active_replay_is_readonly_without_native_authority",
        "--",
        "--exact",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "legacy_active_replay_is_readonly_without_native_authority",
        "1 passed; 0 failed"
      ],
      "required_stderr": []
    }
  ]
}

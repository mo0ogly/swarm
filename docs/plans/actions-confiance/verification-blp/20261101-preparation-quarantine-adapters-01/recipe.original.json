{
  "schema_version": 1,
  "id": "blp-preparation-quarantine-adapters",
  "inputs": [
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    "rust/crates/*/Cargo.toml",
    "rust/crates/*/src/**/*",
    "rust/crates/swarm-engine/config/**/*",
    "rust/crates/swarm-engine/tests/confidentiality.rs",
    "tools/verification/recipe.py",
    "web/trust-confidentiality.js",
    "web/trust-native.html",
    "locales/en.json",
    "web/i18n-en.js",
    "rust/crates/swarm-engine/examples/preparation_quarantine_fixture.rs"
  ],
  "environment": {
    "CARGO_TARGET_DIR": "{root}/.cache/blp-verification-target",
    "CARGO_INCREMENTAL": "0",
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_BUILD_JOBS": "1"
  },
  "steps": [
    {
      "id": "http-quarantine-refusal-and-cleanup",
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-web",
        "--lib",
        "service::tests::preparation_quarantine_status_keeps_cleanup_failures_server_errors",
        "--",
        "--exact",
        "--nocapture"
      ],
      "expected_exit": 0,
      "required_stdout": [
        "preparation_quarantine_status_keeps_cleanup_failures_server_errors",
        "1 passed; 0 failed"
      ],
      "required_stderr": []
    },
    {
      "id": "build-separate-pending-fixture-helper",
      "command": [
        "cargo",
        "build",
        "--manifest-path",
        "rust/Cargo.toml",
        "--offline",
        "--locked",
        "-p",
        "swarm-engine",
        "--features",
        "test-fixtures",
        "--example",
        "preparation_quarantine_fixture"
      ],
      "expected_exit": 0,
      "required_stdout": [],
      "required_stderr": [
        "Finished"
      ]
    }
  ]
}

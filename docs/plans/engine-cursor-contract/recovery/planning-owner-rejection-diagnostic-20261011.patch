diff --git a/internal/engine/planning_rejection.go b/internal/engine/planning_rejection.go
new file mode 100644
index 0000000000000000000000000000000000000000..b28b2ca8d0b912e34aa7d1d45c5c7ee684b956e0
--- /dev/null
+++ b/internal/engine/planning_rejection.go
@@ -0,0 +1,103 @@
+//go:build linux
+
+package engine
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+// A parsed but refused proposal is new diagnostic input to its owner, not a
+// mission-wide failure or an applied decision. Original response and admission
+// receipt are durable; the projected diagnostic names the exact failed operation
+// without pretending to supply the full raw response as review evidence.
+func (s *Store) planningRejected(work, scope string, generation int, claim, reply string, cause error) error {
+	rawPath := filepath.ToSlash(filepath.Join(".swarm", "planning", work, claim+"-rejected-"+hash([]byte(reply))+".json"))
+	if err := os.MkdirAll(filepath.Dir(filepath.Join(s.root, rawPath)), 0700); err != nil {
+		return s.planningFailure(work, scope, generation, "Stockage du refus indisponible : "+err.Error())
+	}
+	if err := atomicWrite(filepath.Join(s.root, rawPath), []byte(reply)); err != nil {
+		return s.planningFailure(work, scope, generation, "Conservation de la proposition refusée impossible : "+err.Error())
+	}
+	for attempt := 0; attempt < 3; attempt++ {
+		w, err := s.get(work)
+		if err != nil {
+			return err
+		}
+		if w.Planning == nil {
+			return nil
+		}
+		owner, err := w.Planning.scope(scope)
+		if err != nil {
+			return err
+		}
+		if owner.Generation != generation || owner.Holder == "" {
+			return nil
+		}
+		operation := map[string]any{}
+		key := cause.Error()
+		var failed *planningOperationError
+		if errors.As(cause, &failed) {
+			operation = map[string]any{"index": failed.Index + 1, "kind": failed.Kind, "id": failed.ID}
+			key = failed.Kind + "\n" + failed.ID + "\n" + failed.Err.Error()
+		}
+		state := planningRejectionState(w, owner)
+		eventID := "planning-rejected-" + hash([]byte(scope+"\n"+key+"\n"+state))
+		var proposed PlanningProposal
+		identities := []map[string]any{}
+		if json.Unmarshal([]byte(reply), &proposed) == nil {
+			for index, op := range proposed.Operations {
+				identities = append(identities, map[string]any{"index": index + 1, "kind": op.Kind, "id": op.ID})
+			}
+		}
+		diagnostic := map[string]any{"scope": scope, "generation": generation, "claim": claim, "cause": cause.Error(), "failed_operation": operation, "operation_inventory": identities, "proposed_input_events": proposed.Inputs, "raw_response": ExchangeArtifact{Path: rawPath, SHA256: hash([]byte(reply))}, "received_delivery": owner.Delivery, "workflow": owner.Workflow, "state_sha256": state, "effect": "Entire proposal refused; no operation applied and no input acknowledged. JSON response returned by the provider adapter retained intact; this diagnostic supplies its reference and exact operation identities, not its full content. Reassess current state and correct the proposed operation within authority. A task operation requires a new global task ID, unique within the proposal too; existing tasks are not recreated."}
+		data, _ := json.Marshal(diagnostic)
+		path := filepath.ToSlash(filepath.Join(filepath.Dir(rawPath), "diagnostic-"+hash(data)+".json"))
+		if err = atomicWrite(filepath.Join(s.root, path), data); err != nil {
+			return s.planningFailure(work, scope, generation, "Conservation du diagnostic impossible : "+err.Error())
+		}
+		_, err = s.mutate(work, "planning.rejected", claim+"-rejected", w.Revision, data, func(current *Work) error {
+			if current.Planning == nil {
+				return nil
+			}
+			target, err := current.Planning.scope(scope)
+			if err != nil {
+				return err
+			}
+			if target.Generation != generation || target.Holder == "" {
+				return nil
+			}
+			if planningRejectionState(*current, target) != state {
+				return planningError("revision_conflict", "préconditions du refus modifiées ; relire le contexte")
+			}
+			repeated := false
+			for _, event := range current.Planning.Inbox {
+				if event.ID == eventID {
+					repeated = true
+				}
+			}
+			if repeated {
+				target.RejectionWait = &PlanningRejectionWait{Event: eventID, StateSHA256: state}
+			} else {
+				current.Planning.Inbox = append(current.Planning.Inbox, PlanningEvent{ID: eventID, Scope: scope, Kind: "planning_rejected", Message: "Proposition refusée : " + cause.Error() + ". Diagnostic attribué fourni ; aucune opération ni acceptation appliquée.", Handoff: &ExchangeArtifact{Path: path, SHA256: hash(data)}, At: now()})
+				target.RejectionWait = nil
+			}
+			target.Holder = ""
+			target.Until = ""
+			target.Generation++
+			target.Revision++
+			target.State = "ready"
+			return nil
+		})
+		if err == nil {
+			return fmt.Errorf("proposition refusée, diagnostic transmis à %s : %w", scope, cause)
+		}
+		if commandFailure(err).Code != "revision_conflict" {
+			return err
+		}
+	}
+	return fmt.Errorf("diagnostic de refus à retransmettre après conflit : %w", cause)
+}
diff --git a/internal/engine/planning_rejection_state.go b/internal/engine/planning_rejection_state.go
new file mode 100644
index 0000000000000000000000000000000000000000..229684951abe3bb54d2cac175dc2fa8f996f524a
--- /dev/null
+++ b/internal/engine/planning_rejection_state.go
@@ -0,0 +1,54 @@
+package engine
+
+import (
+	"encoding/json"
+	"fmt"
+)
+
+type planningOperationError struct {
+	Index    int
+	Kind, ID string
+	Err      error
+}
+
+func (e *planningOperationError) Error() string {
+	return fmt.Sprintf("opération %d %s[%s] : %s", e.Index+1, e.Kind, e.ID, e.Err)
+}
+func (e *planningOperationError) Unwrap() error { return e.Err }
+
+// Ignore leases, inference counters and the diagnostic itself: none constitutes
+// a changed precondition. Owned task/review state, public inputs and explicit
+// policy changes do. Other scopes remain independently eligible.
+func planningRejectionState(w Work, owner *PlanningScope) string {
+	tasks := []Task{}
+	existingIDs := []string{}
+	for _, task := range w.Tasks {
+		existingIDs = append(existingIDs, task.ID)
+		if planningScopeWithin(w.Planning, task.ScopeID, owner.ID) {
+			tasks = append(tasks, task)
+		}
+	}
+	inputs := []PlanningEvent{}
+	for _, event := range w.Planning.Inbox {
+		if event.Scope == owner.ID && event.Decision == "" && event.Kind != "planning_rejected" {
+			inputs = append(inputs, event)
+		}
+	}
+	children := []map[string]any{}
+	for _, child := range w.Planning.Scopes {
+		if child.Parent == owner.ID {
+			children = append(children, map[string]any{"id": child.ID, "state": child.State, "requirements": child.Requirements})
+		}
+	}
+	var reviewer *ReviewerConfig
+	if w.Planning.Reviewer != nil {
+		copy := *w.Planning.Reviewer
+		copy.Calls = 0
+		reviewer = &copy
+	}
+	raw, _ := json.Marshal(map[string]any{"existing_task_ids": existingIDs, "objective": owner.Objective, "requirements": owner.Requirements, "criteria": w.Criteria, "tasks": tasks, "inputs": inputs, "children": children, "provider": w.Planning.Provider, "provider_digest": w.Planning.ProviderDigest, "route": w.Planning.ModelRoute, "scope_model": owner.ModelSelection, "reviewer": reviewer, "repository": w.Planning.Repository, "max_tasks": w.Planning.MaxTasks, "max_activations": w.Planning.MaxActivations, "max_decisions": w.Planning.MaxDecisions, "scope_task_limit": owner.TaskLimit, "scope_activation_limit": owner.ActivationLimit})
+	return hash(raw)
+}
+func planningRejectionUnchanged(w Work, scope *PlanningScope) bool {
+	return scope.RejectionWait != nil && scope.RejectionWait.StateSHA256 == planningRejectionState(w, scope)
+}

+	owner, _ := w.Planning.scope("root")
+	received := owner.Delivery.UnresolvedReviews[a.TaskID]
+	received.Candidate = "unreceived-candidate"
+	owner.Delivery.UnresolvedReviews[a.TaskID] = received

+<!doctype html>
+<html lang="fr" data-theme="etat"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="swarm-style-nonce" content="SWARM_STYLE_NONCE"><title>Swarm — Console</title><link rel="stylesheet" href="/wattson_themes.css"><link rel="stylesheet" href="/swarm-design.css"><link rel="stylesheet" href="/log-console.css"><script src="/i18n-en.js" defer></script><script src="/i18n.js" defer></script><script type="module" src="/log-console.js"></script></head><body class="journal-frame"><div id="journal-editor" aria-label="Console des journaux, lecture seule"></div></body></html>

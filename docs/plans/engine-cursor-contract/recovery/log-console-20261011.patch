+#journal-console-wrap #log-lines {margin:0;border:0;max-height:65vh;white-space:pre-wrap;overflow-wrap:anywhere}
+.journal-bar {display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin:12px 0}

diff --git a/internal/engine/managed_control_diagnostic_api.go b/internal/engine/managed_control_diagnostic_api.go
new file mode 100644
index 0000000..1045e35
--- /dev/null
+++ b/internal/engine/managed_control_diagnostic_api.go
@@ -0,0 +1,89 @@
+//go:build linux
+
+package engine
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+)
+
+type ManagedControlDiagnosticView struct {
+	Work       string                `json:"work_id"`
+	Task       string                `json:"task_id"`
+	Revision   int                   `json:"revision"`
+	Evidence   string                `json:"evidence_sha256"`
+	Diagnostic managedControlFailure `json:"diagnostic"`
+}
+
+// Only expose the engine-owned original linked to the current blocked result.
+// The client supplies task identity, never an arbitrary private file path.
+func (s *Store) managedControlDiagnostic(work, taskID string) (ManagedControlDiagnosticView, error) {
+	w, err := s.get(work)
+	if err != nil {
+		return ManagedControlDiagnosticView{}, err
+	}
+	task, err := w.task(taskID)
+	if err != nil || w.Planning == nil || w.Planning.Repository == nil || task.Status != "blocked" {
+		return ManagedControlDiagnosticView{}, fmt.Errorf("résultat bloqué avec diagnostic de contrôle attribué requis")
+	}
+	events, err := s.events(work)
+	if err != nil {
+		return ManagedControlDiagnosticView{}, err
+	}
+	for i := len(events) - 1; i >= 0; i-- {
+		event := events[i]
+		if event.Kind != "managed.conflict" {
+			continue
+		}
+		var failure struct {
+			Agent  string `json:"agent"`
+			Reason string `json:"reason"`
+		}
+		if json.Unmarshal(event.Payload, &failure) != nil || failure.Reason != task.Blocker {
+			continue
+		}
+		a, err := s.agent(failure.Agent)
+		if err != nil || a.WorkID != work || a.TaskID != taskID || !currentTaskAttempt(task, a.Attempt) || activeAgent(a) || a.Ended == "" {
+			continue
+		}
+		item, err := s.managedAttempt(a.ID)
+		if err != nil || item.Work != work || item.Task != taskID || item.State != "conflict" || item.Detail != task.Blocker {
+			continue
+		}
+		_, evidence, digest, legacy, err := s.integrationFailureBase(w, a, item)
+		if err != nil {
+			return ManagedControlDiagnosticView{}, err
+		}
+		if legacy {
+			return ManagedControlDiagnosticView{}, fmt.Errorf("sortie originale historique absente ; aucune trace inventée")
+		}
+		path, err := localFile(s.root, evidence)
+		if err != nil {
+			return ManagedControlDiagnosticView{}, err
+		}
+		raw, err := os.ReadFile(path)
+		if err != nil {
+			return ManagedControlDiagnosticView{}, err
+		}
+		if hash(raw) != digest {
+			return ManagedControlDiagnosticView{}, fmt.Errorf("diagnostic modifié pendant la lecture")
+		}
+		var d managedControlFailure
+		if err = json.Unmarshal(raw, &d); err != nil {
+			return ManagedControlDiagnosticView{}, err
+		}
+		if d.OutputBytes < len(d.Output) || d.Truncated != (d.OutputBytes > len(d.Output)) {
+			return ManagedControlDiagnosticView{}, fmt.Errorf("bornes de sortie incohérentes")
+		}
+		current, err := s.get(work)
+		if err != nil {
+			return ManagedControlDiagnosticView{}, err
+		}
+		if current.Revision != w.Revision {
+			return ManagedControlDiagnosticView{}, fmt.Errorf("travail modifié pendant la lecture ; relire le diagnostic courant")
+		}
+		return ManagedControlDiagnosticView{Work: work, Task: taskID, Revision: w.Revision, Evidence: digest, Diagnostic: d}, nil
+	}
+	return ManagedControlDiagnosticView{}, fmt.Errorf("aucun diagnostic original lié au résultat courant")
+}
diff --git a/internal/engine/managed_control_diagnostic_api_test.go b/internal/engine/managed_control_diagnostic_api_test.go
new file mode 100644
index 0000000..1e50769
--- /dev/null
+++ b/internal/engine/managed_control_diagnostic_api_test.go
@@ -0,0 +1,121 @@
+//go:build linux
+
+package engine
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func controlDiagnosticFixture(t *testing.T) (*Store, Work, Agent) {
+	t.Helper()
+	s, w, a, r := recoveredResultFixture(t)
+	var err error
+	w, err = s.mutate(w.ID, "fixture", "failed-control-policy", w.Revision, []byte(`{}`), func(w *Work) error {
+		task, _ := w.task(a.TaskID)
+		task.ValidationPolicy = automaticPolicy("python3", "-c", "print('retained control original');raise SystemExit(7)")
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	task, _ := w.task(a.TaskID)
+	raw, _ := json.Marshal(completeDelivery(task, a))
+	if err = os.WriteFile(filepath.Join(a.CWD, "docs/first.delivery.json"), raw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	gitTest(t, a.CWD, "add", "-A")
+	r.ResultTree = gitTest(t, a.CWD, "write-tree")
+	r.Revision = w.Revision
+	w, err = s.planningChange(w.ID, "submit-recovered-result", r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	task, _ = w.task(a.TaskID)
+	if !strings.Contains(task.Blocker, "contrôle en échec") {
+		t.Fatal("not a control failure", task.Blocker)
+	}
+	return s, w, a
+}
+func TestControlDiagnosticPublicHTTPPreservesOriginalAndHasNoWrite(t *testing.T) {
+	s, w, a := controlDiagnosticFixture(t)
+	h := newWebHandler(s, "local.test", "diag-token")
+	path := "/api/v1/control-diagnostic?work=" + w.ID + "&task=" + a.TaskID
+	rr := runLimitsWebRequest(h, "GET", path, "diag-token", nil)
+	if rr.Code != 200 {
+		t.Fatalf("original diagnostic unavailable: %d %s", rr.Code, rr.Body.String())
+	}
+	var got struct {
+		Evidence   string                `json:"evidence_sha256"`
+		Diagnostic managedControlFailure `json:"diagnostic"`
+	}
+	if err := json.Unmarshal(rr.Body.Bytes(), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.Diagnostic.Work != w.ID || got.Diagnostic.Producer != a.ID || got.Diagnostic.Attempt != a.Attempt || got.Diagnostic.Result.ExitCode != 7 || string(got.Diagnostic.Output) != "retained control original\n" || len(got.Evidence) != 64 {
+		t.Fatal("provenance or original output lost", rr.Body.String())
+	}
+	after, _ := s.get(w.ID)
+	if after.Revision != w.Revision || after.Planning.Reviewer.Calls != w.Planning.Reviewer.Calls {
+		t.Fatal("read changed state or spent a call")
+	}
+	denied := runLimitsWebRequest(h, "GET", path, "wrong-token", nil)
+	if denied.Code == 200 {
+		t.Fatal("unauthenticated original exposed")
+	}
+}
+func TestControlDiagnosticPublicHTTPRejectsStaleOrCorruptBindings(t *testing.T) {
+	for _, mode := range []string{"other-task", "replaced-blocker", "new-attempt", "corrupt-output"} {
+		t.Run(mode, func(t *testing.T) {
+			s, w, a := controlDiagnosticFixture(t)
+			task, _ := w.task(a.TaskID)
+			if mode == "corrupt-output" {
+				parts := controlFailurePattern.FindStringSubmatch(task.Blocker)
+				path, err := localFile(s.root, parts[4])
+				if err != nil {
+					t.Fatal(err)
+				}
+				raw, err := os.ReadFile(path)
+				if err != nil {
+					t.Fatal(err)
+				}
+				var d managedControlFailure
+				if err = json.Unmarshal(raw, &d); err != nil {
+					t.Fatal(err)
+				}
+				d.Output = []byte("tampered")
+				raw, _ = json.Marshal(d)
+				if err = os.WriteFile(path, raw, 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if mode == "replaced-blocker" || mode == "new-attempt" {
+				var err error
+				w, err = s.mutate(w.ID, "fixture", "replace-binding", w.Revision, []byte(`{}`), func(w *Work) error {
+					task, _ := w.task(a.TaskID)
+					if mode == "replaced-blocker" {
+						task.Blocker = "different failure"
+					} else {
+						task.Attempts = append(task.Attempts, Attempt{ID: "replacement", Status: "interrupted"})
+					}
+					return nil
+				})
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			id := a.TaskID
+			if mode == "other-task" {
+				id = "unrelated"
+			}
+			h := newWebHandler(s, "local.test", "diag-token")
+			rr := runLimitsWebRequest(h, "GET", "/api/v1/control-diagnostic?work="+w.ID+"&task="+id, "diag-token", nil)
+			if rr.Code == 200 || strings.Contains(rr.Body.String(), "retained control original") {
+				t.Fatal("stale or corrupt original exposed", rr.Code, rr.Body.String())
+			}
+		})
+	}
+}

+func compactPlanningTaskPreviews(context map[string]json.RawMessage, events []PlanningEvent) bool {
+	protected := map[string]bool{}
+	for _, event := range events {
+		protected[event.Task] = true
+	}
+	var tasks []map[string]json.RawMessage
+	if json.Unmarshal(context["tasks"], &tasks) != nil {
+		return false
+	}
+	omitted := false
+	for _, task := range tasks {
+		var id, state string
+		_ = json.Unmarshal(task["id"], &id)
+		_ = json.Unmarshal(task["status"], &state)
+		if protected[id] || (state != "todo" && state != "accepted") {
+			continue
+		}
+		if _, present := task["next"]; present {
+			delete(task, "next")
+			omitted = true
+		}
+	}
+	if omitted {
+		context["tasks"], _ = json.Marshal(tasks)
+		context["inactive_task_next_omitted"] = json.RawMessage("true")
+		var note string
+		_ = json.Unmarshal(context["projection_note"], &note)
+		context["projection_note"], _ = json.Marshal(note + " Les aperçus next des tâches futures ou acceptées non concernées par ces événements sont omis ; identités, états, exigences, dépendances et entrées complètes restent fournis. Aucune consigne persistée n’est modifiée.")
+	}
+	return omitted
+}

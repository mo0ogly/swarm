+func acceptedRecipeFixture(t *testing.T) (*Store, Work) {
+	t.Helper()
+	s := storeTest(t)
+	w := taskTest(t, s, createTest(t, s))
+	raw := fixture(t, s.root)
+	ev, e := evaluate(raw, s.root, "delivery")

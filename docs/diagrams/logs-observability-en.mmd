flowchart TB
    accTitle: Swarm observability: logs, live views, telemetry and evidence
    accDescr: Agent output, engine events, incidents, decisions, call ledger, system measurements and OTLP retain their sources. Views are read-only; data export is not acceptance evidence.
    subgraph G0["SOURCES"]
        L_AGENT["Attempt output<br/>agent_logs · terminal_events"]
        L_ENGINE["DETERMINISTIC RUST ENGINE<br/>Activity · decisions · incidents<br/>Mission · task · attempt · revision"]
        L_CALLS["Call ledger<br/>Reserved ≠ sent ≠ billed<br/>Known / unknown usage"]
        L_PROC["Linux /proc measurements<br/>Checked host · PID · starttime"]
    end
    subgraph G1["TELEMETRY"]
        L_OTLP["OTLP HTTP JSON<br/>Exporter token bound to active agent"]
        L_NORMAL["Normalize and attribute<br/>Allowed fields · counted rejections"]
        L_TELEMETRY["Separate telemetry.db<br/>Token digest · series · deduplication"]
    end
    subgraph G2["PROJECTIONS"]
        L_ORIGINAL["Retained state and originals<br/>Cursors · sequences · digests"]
        L_API["Authenticated public API<br/>Mission · source · filters · pagination"]
        L_PUSH["Fingerprint-based SSE live updates<br/>Resume / refusal · polling fallback"]
    end
    subgraph G3["CONSULTATION"]
        L_CONSOLE["Tracking → Logs<br/>Read-only Monaco · text fallback<br/>Server / page search distinguished"]
        L_LIVE["Live agents and harness<br/>Activity · limits · context · usage"]
        L_EXPORT["Original response export<br/>Filters and limitations retained"]
    end
    subgraph G4["EVIDENCE"]
        L_CHAIN["Reconstructible evidence chain<br/>Objective → decision → attempt<br/>Candidate → check → review"]
        L_ACCEPT["Separately checked acceptance<br/>Same candidate · rights · freshness<br/>Human validation in human mode"]
    end
    subgraph G5["FUTURE"]
        L_SECURITY["AC-02 · future, not started<br/>Network lineage and security timeline"]
    end
    L_AGENT --> L_ORIGINAL
    L_ENGINE --> L_ORIGINAL
    L_CALLS --> L_ORIGINAL
    L_OTLP --> L_NORMAL
    L_NORMAL --> L_TELEMETRY
    L_ORIGINAL --> L_API
    L_TELEMETRY --> L_API
    L_PROC --> L_API
    L_API --> L_CONSOLE
    L_API --> L_PUSH
    L_PUSH --> L_LIVE
    L_API --> L_LIVE
    L_CONSOLE --> L_EXPORT
    L_ORIGINAL -->|Attributed originals| L_CHAIN
    L_ENGINE -->|Decisions and receipts| L_CHAIN
    L_CHAIN --> L_ACCEPT
    L_SECURITY -.->|Extension to implement| L_CHAIN
    classDef ordinary fill:#fffefa,stroke:#205e70,color:#062b49,stroke-width:1.6px;
    classDef core fill:#062b49,stroke:#926300,color:#fffefa,stroke-width:3px;
    classDef control fill:#f5f3ec,stroke:#205e70,color:#243d4a,stroke-width:2px;
    classDef supervisor fill:#205e70,stroke:#205e70,color:#fffefa,stroke-width:2px;
    classDef data fill:#fffefa,stroke:#926300,color:#243d4a,stroke-width:2px;
    classDef pending fill:#f5f3ec,stroke:#926300,color:#243d4a,stroke-width:2px,stroke-dasharray:6 4;
    class L_AGENT,L_PROC,L_CONSOLE,L_LIVE,L_EXPORT ordinary;
    class L_ENGINE core;
    class L_OTLP,L_NORMAL,L_API,L_PUSH,L_ACCEPT control;
    class L_CALLS,L_TELEMETRY,L_ORIGINAL,L_CHAIN data;
    class L_SECURITY pending;
    style G0 fill:#f5f3ec,stroke:#205e70,color:#062b49
    style G1 fill:#f5f3ec,stroke:#205e70,color:#062b49
    style G2 fill:#f5f3ec,stroke:#205e70,color:#062b49
    style G3 fill:#f5f3ec,stroke:#205e70,color:#062b49
    style G4 fill:#f5f3ec,stroke:#205e70,color:#062b49
    style G5 fill:#f5f3ec,stroke:#205e70,color:#062b49
